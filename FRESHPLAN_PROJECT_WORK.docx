.w-mob-component-comment-voice-wrap-bar { position: relative; box-sizing: border-box; min-width: 70px; }

.w-mob-component-comment-voice-wrap-bar-left { position: absolute; background: rgb(236, 244, 253); top: 12px; left: 6px; width: 8px; height: 8px; box-sizing: border-box; transform: rotate(45deg); }

.w-mob-component-comment-voice-wrap-bar .inline-middle { width: 100%; display: block; }

.w-mob-component-comment-voice-wrap-bar-wrap { width: 100%; background: rgba(10, 108, 255, 0.08); height: 38px; border-radius: 4px; padding: 6px; box-sizing: border-box; overflow: hidden; display: flex; align-items: center; }

.w-mob-component-comment-voice-wrap-bar-wrap .icons { height: 20px !important; width: 20px !important; }

.w-mob-component-comment-voice-wrap-duration { padding-left: 8px; box-sizing: border-box; }

.w-mob-component-comment-voice-wrap-error { padding-left: 10px; width: 16px; box-sizing: border-box; }

.w-mob-component-comment-voice-wrap-error i { line-height: 0; margin-top: 10px; }

.w-mob-component-comment-voice-wrap-transfer { margin-left: 8px; background: rgb(245, 247, 250); border-radius: 999px; display: flex; align-items: center; height: 26px !important; }

.w-mob-component-comment-voice-wrap-transfer span { margin: 4px 12px; font-size: 11px; color: rgba(8, 14, 23, 0.46); }

.w-mob-component-comment-voice-text-success { width: auto; display: inline-block; margin-top: 5px; min-height: 36px; background: rgba(10, 108, 255, 0.08); white-space: normal; border-radius: 4px; padding: 10px; box-sizing: border-box; font-size: 12px; color: rgb(56, 56, 56); letter-spacing: 0px; line-height: 16px; }

.w-mob-component-comment-voice-text-success .w-mob-component-comment-voice-text-tip { background: none; }

.w-mob-component-comment-voice-text-tip { background: rgba(10, 108, 255, 0.08); }

.w-mob-component-comment-voice-text-tip.border { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.w-mob-component-comment-voice-text-tip .ico { margin-top: 2px; }

.w-mob-component-comment-voice-overlay { z-index: 100; transform: translateZ(100px); }

.w-mob-component-comment-voice-overlay .popover-body, .w-mob-component-comment-voice-overlay .popover-content-wrap { padding: 0px; }

.w-mob-component-comment-voice-text-tip.border { margin-left: 0px; }

.water-drop-cursor .water-drop-pointer-down { pointer-events: none; width: 2.5px; }

.w-mob-component-component-comment-dropdown { display: -webkit-flex; font-size: 14px; color: rgb(255, 255, 255); letter-spacing: 0px; text-align: center; }

.w-mob-component-component-comment-dropdown :not(:first-child) { border-left: 1px solid rgb(223, 223, 224); box-sizing: border-box; }

.w-mob-component-component-comment-dropdown > div { padding: 11px 17.5px; }

.w-mob-component-comment-text.bookmark pre { animation: 1s ease 0s 5 normal none running backgroundColorChange; }

.w-mob-component-comment-text .hyperlink { color: rgb(73, 145, 242); text-decoration: underline; }

@keyframes backgroundColorChange { 
  0% { background: rgb(244, 181, 57); opacity: 0.2; }
  100% { background-color: inherit; }
}

.water-drop-cursor .water-drop-pointer-down { pointer-events: none; width: 2.5px; }

.w-mob-component-comment { position: relative; width: 100%; height: auto; padding-top: 6px; padding-left: 16px; }

.w-mob-component-comment-border { border-bottom: 1px solid rgb(219, 219, 219); }

.w-mob-component-comment-noborder { border-bottom: 1px solid transparent; }

.w-mob-component-comment.loading { opacity: 0.6; }

.w-mob-component-comment-header { overflow: hidden; position: relative; height: 24px; padding-left: 34px; padding-right: 20px; box-sizing: border-box; display: flex; }

.w-mob-component-comment-header .avatar { position: absolute; width: 24px; height: 24px; left: 0px; border-radius: 50%; overflow: hidden; }

.w-mob-component-comment-header .avatar img { width: 100%; height: 100%; border-radius: 50%; }

.w-mob-component-comment-header .username { height: 24px; font-size: 12px; color: gray; letter-spacing: 0px; line-height: 24px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; overflow-wrap: normal; flex: 1 1 0%; }

.w-mob-component-comment-header .date { height: 24px; font-size: 12px; color: rgb(161, 161, 161); letter-spacing: 0px; line-height: 24px; }

.w-mob-component-comment-text { padding-left: 34px; padding-right: 16px; box-sizing: border-box; }

.w-mob-component-comment-text .reply-author { color: rgb(0, 0, 0); font-size: 14px; line-height: 20px; }

.w-mob-component-comment-text .reply-author span { color: rgb(153, 153, 153); }

.w-mob-component-comment-text pre { font-family: BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, "PingFang SC", "Microsoft Yahei", "Hiragino Sans GB", sans-serif, "Wps Emoji", "apple color emoji", "Noto Color Emoji", "segoe ui emoji", "segoe ui symbol"; line-height: 16px; font-size: 12px; color: rgb(56, 56, 56); letter-spacing: 0px; white-space: pre-wrap; overflow-wrap: break-word; padding-top: 2px; margin-bottom: 10px; }

.w-mob-component-comment .inline-middle { width: 100%; }

.w-mob-component-comment .w-mob-component-feedback { height: 48px; }

.w-mob-component-comment .w-mob-component-feedback .comment-unable-view { font-size: 12px; margin: 2px 16px 10px 34px; }

.component-context-menu { position: absolute; z-index: 1020; background: rgb(255, 255, 255); box-shadow: rgba(9, 23, 49, 0.21) 0px 2px 6px 0px; border: 0.5px solid rgba(0, 0, 0, 0.12); border-radius: 8px; padding: 0px 8px; max-width: calc(100% - 20px); overflow: auto; }

.component-context-menu .group-divider { position: relative; width: calc(100% - 24px); margin: 0px 12px; }

.component-context-menu .group-divider::before { content: ""; position: absolute; left: 0px; right: 0px; top: 0px; height: 1px; background: rgb(217, 217, 217); transform: scaleY(0.5); transform-origin: left top; }

.component-context-menu .context-menu-group { white-space: nowrap; }

.component-context-menu .menu-content { display: inline-flex; align-items: center; justify-content: center; flex-direction: column; min-width: 48px; padding: 4px; border-radius: 2px; }

.component-context-menu .menu-content .menu-text { display: none; font-size: 10px; }

.component-context-menu .menu-content > :nth-child(2) { padding-top: 2px; }

.context-menu-item { position: relative; vertical-align: top; display: inline-flex; justify-content: center; padding: 6px 0px; }

.context-menu-item.show-border::after { content: ""; position: absolute; left: 0px; right: 0px; bottom: 0px; height: 1px; background: rgb(217, 217, 217); transform: scaleY(0.5); transform-origin: left bottom; }

.context-menu-item:active .menu-content { background: rgb(233, 236, 240); }

html[lang="zh-CN"] .component-context-menu .menu-text { display: inline-flex; }

.component-avatar { flex-shrink: 0; position: relative; display: inline-block; height: 24px; width: 24px; border-radius: 50%; overflow: hidden; }

.component-avatar .avatar-img { position: absolute; height: 100%; width: 100%; overflow: hidden; border-radius: 50%; }

.component-avatar .avatar-img .avatar-content { position: absolute; width: 100%; height: 100%; pointer-events: none; }

.component-avatar .avatar-img .icons { width: 100%; height: 100%; }

.component-avatar::after, .component-avatar::before { content: ""; position: absolute; background: rgb(255, 255, 255); z-index: 1; }

.component-avatar::before { width: 1px; height: 100%; left: 50%; top: 0px; transform: translateX(-50%); }

.component-avatar::after { height: 1px; width: 100%; left: 0px; top: 50%; transform: translateY(-50%); }

.component-avatar.avatar-length-1 .avatar-img { position: relative; }

.component-avatar.avatar-length-1 .avatar-content { left: 0px; top: 0px; }

.component-avatar.avatar-length-1::after, .component-avatar.avatar-length-1::before, .component-avatar.avatar-length-2::after { display: none; }

.component-avatar.avatar-length-2 > :first-child { left: -50%; }

.component-avatar.avatar-length-2 > :first-child .avatar-content { top: 0px; right: -25%; }

.component-avatar.avatar-length-2 > :nth-child(2) { left: 50%; }

.component-avatar.avatar-length-2 > :nth-child(2) .avatar-content { top: 0px; left: -25%; }

.component-avatar.avatar-length-3::before { top: 0px; bottom: 0px; }

.component-avatar.avatar-length-3::after { left: 50%; right: 0px; }

.component-avatar.avatar-length-3 > :first-child .avatar-content { left: -25%; }

.component-avatar.avatar-length-3 > :nth-child(2) { left: 50%; top: -50%; }

.component-avatar.avatar-length-3 > :nth-child(2) .avatar-content { left: -25%; bottom: -25%; }

.component-avatar.avatar-length-3 > :nth-child(3) { left: 50%; top: 50%; }

.component-avatar.avatar-length-3 > :nth-child(3) .avatar-content { left: -25%; top: -25%; }

.component-avatar.avatar-length-4::before { top: 0px; bottom: 0px; }

.component-avatar.avatar-length-4::after { left: 0px; right: 0px; }

.component-avatar.avatar-length-4 > :first-child { left: -50%; top: -50%; }

.component-avatar.avatar-length-4 > :first-child .avatar-content { right: -25%; bottom: -25%; }

.component-avatar.avatar-length-4 > :nth-child(2) { left: -50%; top: 50%; }

.component-avatar.avatar-length-4 > :nth-child(2) .avatar-content { right: -25%; top: -25%; }

.component-avatar.avatar-length-4 > :nth-child(3) { left: 50%; top: -50%; }

.component-avatar.avatar-length-4 > :nth-child(3) .avatar-content { left: -25%; bottom: -25%; }

.component-avatar.avatar-length-4 > :nth-child(4) { left: 50%; top: 50%; }

.component-avatar.avatar-length-4 > :nth-child(4) .avatar-content { left: -25%; top: -25%; }

.component-avatar-info { display: flex; flex-direction: column; align-items: center; }

.component-avatar-info .component-avatar { margin-top: 44px; width: 60px; height: 60px; margin-bottom: 12px; }

.component-avatar-info .name { color: var(--kd-color-text-primary); height: 22px; font-size: 14px; line-height: 22px; max-width: 90%; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; }

.component-avatar-info .address { height: 20px; line-height: 20px; font-size: 12px; color: var(--kd-color-text-secondary); margin-bottom: 50px; max-width: 70%; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; }

.component-avatar-info { display: flex; flex-direction: column; align-items: center; }

.component-avatar-info .component-avatar { margin-top: 44px; width: 60px; height: 60px; margin-bottom: 12px; }

.component-avatar-info .name { color: var(--kd-color-text-primary); height: 22px; font-size: 14px; line-height: 22px; max-width: 90%; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; }

.component-avatar-info .address { height: 20px; line-height: 20px; font-size: 12px; color: var(--kd-color-text-secondary); margin-bottom: 50px; max-width: 70%; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; }

.water-drop-cursor .water-drop-pointer-down { pointer-events: none; width: 2.5px; }

.w-comment-list-ctn-item { pointer-events: none; }

.w-mob-component-comments { width: 100%; color: rgb(255, 255, 255); position: relative; padding-top: 16px; }

.w-mob-component-comments-triangle { position: absolute; background: rgb(250, 250, 250); top: 8px; left: 20px; width: 15px; height: 15px; transform: rotate(45deg); }

.w-mob-component-comments-container { width: 100%; height: auto; background: rgb(250, 250, 250); pointer-events: auto; }

.float-element-wrapper { position: absolute; z-index: 11; top: 0px; left: 0px; }

.drag-mark { display: block; position: absolute; color: rgb(62, 128, 236); font-weight: bold; width: 4px; height: 8px; }

.drag-mark.left-drag-mark { border-left: 2px solid rgb(62, 128, 236); }

.drag-mark.left-drag-mark, .drag-mark.right-drag-mark { display: block; border-top: 2px solid rgb(62, 128, 236); border-bottom: 2px solid rgb(62, 128, 236); }

.drag-mark.right-drag-mark { border-right: 2px solid rgb(62, 128, 236); }

.wps-dialog .tip-content { margin-top: 8px; line-height: 16px; color: rgb(118, 124, 133); }

.wps-dialog .font-content-list-wrapper { max-height: 216px; background-color: rgb(245, 247, 251); padding: 12px; border-radius: 6px; margin-top: 12px; gap: 8px; display: flex; flex-direction: column; overflow: auto; }

.wps-dialog .font-content-list-wrapper .font-incomplete-item { height: 32px; display: flex; align-items: center; }

.wps-dialog .font-content-list-wrapper .font-incomplete-item .font-incomplete-name { float: left; font-weight: 400; padding-right: 2px; }

.wps-top-toolbar { position: absolute; z-index: 99; width: 100%; transition: top 0.3s; }

.save-version-fail { position: relative; display: flex; align-items: center; padding-right: 8px; }

.save-version-fail .icons { margin-right: 8px; margin-left: -8px; }

.save-version-fail .save-version-retry { padding: 3px 0px 3px 26px; background: rgb(255, 255, 255); color: rgb(65, 127, 249); }

.save-version-fail-modal .save-fail-content { display: flex; align-items: flex-start; margin-top: 4px; padding: 12px 1px 12px 12px; border-radius: 8px; background-color: var(--kd-color-background-plate,#f5f5f5); text-align: left; white-space: pre-wrap; word-break: break-word; color: var(--kd-color-text-secondary,hsla(0,0%,5%,.66)); }

.save-version-fail-modal .save-fail-content .save-fail-content-text { flex: 1 1 0%; }

.save-version-fail-modal .save-fail-copy-btn { width: 28px; height: fit-content; margin-right: 6px; }

.save-version-fail-modal .save-fail-copy-btn .save-fail-copy-icon .kd-color-icon-blue-primary, .save-version-fail-modal .save-fail-copy-btn .save-fail-copy-icon .kd-color-icon-primary { fill: var(--kd-color-icon-public,#1e5fc7); stroke: var(--kd-color-icon-public,#1e5fc7); }

.kd-tooltip.wo-tooltip .kd-tooltip-content { word-break: normal; overflow-wrap: break-word; }

.kd-tooltip { z-index: var(--kd-z-index-tip); background: var(--kd-color-background-top); border: 1px solid var(--kd-color-line-regular); border-radius: var(--kd-border-radius-middle); box-shadow: var(--kd-box-shadow-large); }

.kd-tooltip, .kd-tooltip-content { color: var(--kd-color-text-primary); }

.kd-tooltip-content { padding: 6px 12px; font-size: var(--kd-font-size-sub-base); line-height: 20px; word-break: normal; overflow-wrap: break-word; white-space: normal; box-sizing: border-box; }

.kd-tooltip-content .kd-tooltip-text { white-space: pre; }

.kd-tooltip-content .kd-tooltip-auto-wrap { word-break: normal; white-space: pre-wrap; }

.kd-tooltip-arrow { background: var(--kd-color-background-top); border-color: var(--kd-color-line-regular); }

.kd-popover { z-index: var(--kd-z-index-popover); background: var(--kd-color-background-top); border: 1px solid var(--kd-color-line-regular); box-shadow: var(--kd-box-shadow-large); border-radius: var(--kd-border-radius-middle); }

.kd-popover-content { padding: 8px; font-size: var(--kd-font-size-sub-base); line-height: 22px; color: var(--kd-color-text-primary); word-break: break-all; overflow-wrap: break-word; white-space: normal; box-sizing: border-box; }

.kd-popover-content .kd-popover-text { white-space: pre; }

.kd-popover-content .kd-popover-auto-wrap { word-break: normal; white-space: pre-wrap; }

.kd-popover-arrow { background: var(--kd-color-background-top); border-color: var(--kd-color-line-regular); }

@keyframes kd-popover-animation { 
  0% { opacity: 0; transform: scale(0.8); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes kd-popper-animation { 
  0% { opacity: 0; transform: scale(0.5); }
  100% { opacity: 1; transform: scale(1); }
}

.kd-popper-fade-appear-active, .kd-popper-fade-exit { animation: 0.1s ease 0s 1 normal none running kd-popper-animation; }

.kd-popup-arrow { position: absolute; width: 11px; height: 11px; border-top-right-radius: 4px; border-style: solid; border-width: 1px 1px 0px 0px; }

[dir="rtl"] .kd-popup-arrow { border-top-right-radius: 0px; border-top-left-radius: 4px; border-width: 1px 0px 0px 1px; }

[x-placement^="bottom"] .kd-popup-arrow { top: -6.5px; transform: rotate(-45deg); }

[dir="rtl"] [x-placement^="bottom"] .kd-popup-arrow { transform: rotate(45deg); }

[x-placement^="top"] .kd-popup-arrow { bottom: -6.5px; transform: rotate(135deg); }

[dir="rtl"] [x-placement^="top"] .kd-popup-arrow { transform: rotate(-135deg); }

[x-placement^="left"] .kd-popup-arrow { right: -6.5px; transform: rotate(45deg); }

[dir="rtl"] [x-placement^="left"] .kd-popup-arrow { transform: rotate(135deg); }

[x-placement^="right"] .kd-popup-arrow { left: -6.5px; transform: rotate(-135deg); }

[dir="rtl"] [x-placement^="right"] .kd-popup-arrow { transform: rotate(-45deg); }

.wo-button { display: inline-block; }

.wo-button.disabled { pointer-events: inherit; }

.wo-button.is-block, .wo-button .kd-button { width: 100%; }

.wo-button.with-theme { --kd-color-public-normal: var(--kd-color-brand-normal); --kd-color-public-hover: var(--kd-color-brand-hover); --kd-color-public-pressed: var(--kd-color-brand-pressed); --kd-color-public-light: var(--kd-color-brand-light); --kd-color-text-public: var(--kd-color-text-brand); --kd-color-state-pressed-public: var(--kd-color-state-pressed-brand); --kd-color-line-public: var(--kd-color-line-brand); --kd-color-icon-public: var(--kd-color-icon-brand); }

.wo-button .kd-icon { line-height: 0; }

.wo-button-xs .kd-button { height: 20px !important; }

.wo-button-xs .kd-button-icon { min-width: 20px !important; }

.icons { vertical-align: middle; display: inline-block; background-repeat: no-repeat; background-size: 100% 100%; flex-shrink: 0; }

.icons.icons-16 { width: 16px; height: 16px; }

.icons.icons-24 { width: 24px; height: 24px; }

.icons.icons-30 { width: 30px; height: 30px; }

.icons.icons-38 { width: 38px; height: 38px; }

.icons.icons-48 { width: 48px; height: 48px; }

.icons.icons-64 { width: 64px; height: 64px; }

.icons.icons-loading { position: relative; }

.icons.icons-loading::after, .icons.icons-loading::before { content: ""; position: absolute; inset: 0px; border-radius: 50%; border: 2px solid transparent; }

.icons.icons-loading::before { border-color: var(--kd-color-line-regular); }

.icons.icons-loading::after { animation: 1s linear 0s infinite normal none running icons-loading; border-top-color: rgb(65, 127, 249); }

@keyframes icons-loading { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

.theme-k .icons.icons-loading::after, .theme-s .icons.icons-loading::after { border-top-color: var(--kd-color-brand-normal); }

.theme-d .icons.icons-loading::after { border-top-color: var(--db-color-normal,#0bb); }

.theme-w .icons.icons-loading::after { border-top-color: rgb(73, 145, 242); }

.theme-p .icons.icons-loading::after { border-top-color: rgb(244, 109, 67); }

.theme-f .icons.icons-loading::after { border-top-color: var(--kd-color-brand-normal,#eb5451); }

.theme-b .icons.icons-loading::after { border-top-color: rgb(98, 107, 132); }

.theme-o .icons.icons-loading::after { border-top-color: rgb(118, 99, 221); }

.wowui-tooltip { position: fixed; top: 0px; left: 0px; right: 10px; z-index: 1040; }

.wowui-tooltip-content { position: absolute; }

.wowui-tooltip-content.not-lottie { background: var(--kd-color-background-top); box-shadow: rgba(56, 56, 56, 0.2) 0px 2px 12px 0px; border-radius: 4px; color: var(--kd-color-text-secondary); max-width: 80%; padding: 8px 12px; line-height: 1.5; transform-origin: center top; animation: 0.1s ease 0s 1 normal none running wowui-toast-animation; }

.wowui-tooltip-content .tooltip-text { white-space: pre; }

.wowui-tooltip-content .tooltip-auto-wrap { max-width: 326px; white-space: pre-wrap; word-break: normal; }

@keyframes wowui-toast-animation { 
  0% { opacity: 0; transform: scale(0.8); }
  100% { opacity: 1; transform: scale(1); }
}

.content-vertical-align { display: flex; align-items: center; }

.scrollbar-hover-show::-webkit-scrollbar-thumb { display: none; }

.scrollbar-hover-show:hover::-webkit-scrollbar-thumb { display: initial; }

.wowui-lottie { display: inline-block; box-sizing: content-box; overflow: hidden; box-shadow: var(--kd-box-shadow-large); border: 1px solid var(--kd-color-line-regular); border-radius: var(--kd-border-radius-large); }

.kd-button { position: relative; display: inline-flex; max-width: 100%; margin: 0px; font-family: inherit; font-size: var(--kd-font-size-sub-base); font-weight: 400; line-height: 22px; text-align: center; white-space: nowrap; vertical-align: middle; cursor: pointer; background: transparent; border: 1px solid transparent; border-radius: var(--kd-border-radius-middle); outline: none; justify-content: center; align-items: center; box-sizing: border-box; appearance: none; user-select: none; }

.kd-button .kd-icon { display: inline-block; font-size: 16px; vertical-align: middle; }

.kd-button .kd-button-children { display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.kd-button-children + .kd-button-suffix-icon, .kd-icon + .kd-button-children { margin-left: 4px; }

[dir="rtl"] .kd-button-children + .kd-button-suffix-icon, [dir="rtl"] .kd-icon + .kd-button-children { margin-left: 0px; margin-right: 4px; }

.kd-button[disabled] { cursor: not-allowed; }

.kd-button-loading { pointer-events: none; cursor: unset; }

.kd-button-loading, .kd-button[disabled] { opacity: var(--kd-opacity-disabled); }

.kd-button-sm { height: 24px; padding: 0px 5px; border-radius: var(--kd-border-radius-small); }

.kd-button-m { height: 28px; padding: 2px 11px; }

.kd-button-lg { height: 32px; padding: 4px 15px; }

.kd-button-xl { height: 36px; padding: 6px 19px; font-size: var(--kd-font-size-middle); }

.kd-button-icon.is-compact, .kd-button-light.is-compact { padding: 2px; }

.kd-button-primary { color: var(--kd-color-text-white); background: var(--kd-color-public-normal); }

.kd-button-primary:hover { background: var(--kd-color-public-hover); }

.kd-button-primary:active { background: var(--kd-color-public-pressed); }

.kd-button-primary .kd-button-children.pure { min-width: 40px; }

.kd-button-primary.is-active { background: var(--kd-color-public-pressed); }

