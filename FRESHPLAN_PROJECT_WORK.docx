@keyframes fadeInDown { 
  0% { opacity: 0; transform: translate3d(0px, -50%, 0px); }
  100% { opacity: 1; }
}

@keyframes fadeOutUp { 
  0% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(0px, -5px, 0px); }
}

@keyframes fadeInUp { 
  0% { opacity: 0; transform: translate3d(0px, 100%, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@keyframes fadeInRight { 
  0% { opacity: 0; transform: translate3d(-100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@keyframes fadeScaleYIn { 
  0% { opacity: 0; transform: scaleY(0.8); }
  100% { opacity: 1; transform: scaleY(1); }
}

@keyframes bounceIn { 
  0%, 20%, 40%, 60%, 80%, 100% { animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1); }
  0% { opacity: 0; transform: scale3d(0.3, 0.3, 0.3); }
  100% { opacity: 1; transform: scaleX(1); }
}

html { --kd-z-index-invisible: -100; --kd-z-index-default: 1; --kd-z-index-float: 10; --kd-z-index-mask: 999; --kd-z-index-dialog: 1000; --kd-z-index-reminder: 1020; --kd-z-index-popover: 1030; --kd-z-index-popupmenu: 1040; --kd-z-index-tip: 1050; --kd-color-state-pressed-brand-filter: invert(37%) sepia(95%) saturate(4253%) hue-rotate(209deg) brightness(99%) contrast(107%); --kd-opacity-disabled: .3; --kd-color-brand-disable: rgba(var(--kd-color-brand-6),var(--kd-opacity-disabled)); --kd-color-text-disable: rgba(var(--kd-color-gray-10),.27); --kd-stroke-width-icon-regular: 1px; --kd-is-kdesign-theme: "#000"; }

.hyperlink-editor-header { font-size: 16px; width: calc(100% + 32px); margin-left: -16px; padding: 12px 16px; margin-top: 32px; gap: 16px; display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; }

.hyperlink-editor-header .component-text-btn { width: 164px; height: 42px; line-height: 42px; text-align: center; border-radius: 4px; }

.hyperlink-editor-header .component-text-btn:first-of-type { background-color: rgb(245, 247, 250); }

.hyperlink-editor-header .component-text-btn:nth-of-type(2) { background-color: rgb(10, 108, 255); color: rgb(255, 255, 255); }

.w-mob-component-hyperlink-editor { margin: 20px; }

.link-link, .link-text { font-size: 14px; color: rgb(133, 133, 133); height: 40px; line-height: 40px; }

.link-link { margin-top: 16px; }

.hyperlink-link, .hyperlink-text { width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 4px; padding: 8px 12px; background: rgb(242, 242, 242); font-size: 16px; height: 40px; line-height: 40px; }

.withoutHeadBar .panel-body { padding: 0px; }

.withoutHeadBar .panel-body .component-panel-header::after, .withoutHeadBar .panel-body::before { content: none; }
