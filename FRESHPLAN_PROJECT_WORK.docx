.menu-search { width: 100%; display: flex; flex-direction: column; }

.component-menu-search { display: flex; align-items: center; min-width: 248px; margin: 4px 8px 8px; line-height: 22px; border: 1px solid var(--kd-color-line-regular); border-radius: 2px; height: auto; padding: 0px; flex-shrink: 0; }

.component-menu-search.focus { border-color: var(--kd-color-brand-normal); }

