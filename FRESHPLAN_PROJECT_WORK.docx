.component-dropdown-popup.origin-left-top { transform-origin: right bottom; }

.component-dropdown-popup.origin-right-top { transform-origin: left bottom; }

.component-dropdown-popup.origin-right-bottom { transform-origin: left top; }

.component-dropdown-popup.origin-left-bottom { transform-origin: right top; }

.wo-dropdown-panel { background: var(--kd-color-background-top); border: 1px solid var(--kd-color-line-regular); box-shadow: var(--kd-box-shadow-large); border-radius: 8px; display: flex; flex-direction: column; overflow: hidden auto; }

.wo-dropdown-panel.can-resize .drag-hand { display: block; }

.wo-dropdown-panel .dropdown-panel-content { padding: 12px; flex-grow: 1; height: 100%; display: flex; flex-direction: column; }

.wo-dropdown-panel .dropdown-panel-content .panel-item { flex-shrink: 0; position: relative; display: flex; align-items: center; white-space: normal; color: var(--kd-color-text-primary); font-size: 14px; padding: 5px 24px 5px 8px; border-radius: 6px; margin-top: 4px; line-height: 22px; box-sizing: border-box; }

.wo-dropdown-panel .dropdown-panel-content .panel-item:first-child { margin-top: 0px; }

.wo-dropdown-panel .dropdown-panel-content .panel-item.hover, .wo-dropdown-panel .dropdown-panel-content .panel-item:hover { background: var(--kd-color-state-hover); }

.wo-dropdown-panel .dropdown-panel-content .panel-item-tick { top: calc(50% - 8px); }

.wo-dropdown-panel .dropdown-panel-content .panel-item.selected .panel-item-tick { position: absolute; content: ""; width: 16px; height: 16px; left: 8px; }

.wo-dropdown-panel .dropdown-panel-content .panel-item.selected .panel-item-tick .kd-color-icon-primary { fill: var(--kd-color-icon-public); stroke: var(--kd-color-icon-public); }

.wo-dropdown-panel .dropdown-panel-content .panel-item.only-text { line-height: 22px; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; overflow-wrap: normal; }

.wo-dropdown-panel .dropdown-panel-content .panel-item .icons { margin-right: 8px; }

.wo-dropdown-panel .dropdown-panel-content .divider-line, .wo-dropdown-panel .dropdown-panel-content .kd-menu-divider { width: 85%; margin: 4px auto 0px; height: 1px; background: var(--kd-color-line-light); flex-shrink: 0; }

.wo-dropdown-panel.wo-dropdown-panel-selectable .panel-item { cursor: pointer; padding-left: 32px; }

.wo-dropdown-panel .drag-hand { position: absolute; display: none; }

