.component-recorder-tip { position: absolute; top: calc(50% - 188px); left: calc(50% - 70px); display: flex; flex-direction: column; z-index: 9999; width: 140px; height: 140px; background: rgba(37, 37, 37, 0.9); color: rgb(255, 255, 255); border-radius: 4px; }

.component-recorder-tip .recorder-tip-top { display: flex; justify-content: center; align-items: center; height: 100%; }

