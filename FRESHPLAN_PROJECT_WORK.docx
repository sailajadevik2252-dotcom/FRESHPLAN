.kd-scrollbar-track-horizontal { position: absolute; right: 0px; bottom: 0px; left: 0px; height: 6px; border-radius: 3px; }

.kd-icon { display: inline-block; color: inherit; font-style: normal; line-height: 0; text-align: center; text-transform: none; text-rendering: optimizelegibility; -webkit-font-smoothing: antialiased; }

.kd-icon-spin svg { animation: 1s linear 0s infinite normal none running kd-icon-spin; }

