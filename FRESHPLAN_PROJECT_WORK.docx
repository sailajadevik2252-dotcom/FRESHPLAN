  100% { transform: rotate(1turn); }
}

.kd-checkbox { display: inline-flex; min-height: 20px; line-height: 20px; color: var(--kd-color-text-primary); white-space: normal; user-select: none; align-items: flex-start; }

.kd-checkbox, .kd-checkbox-input { position: relative; cursor: pointer; }

.kd-checkbox-input { top: 3.5px; display: flex; white-space: nowrap; vertical-align: middle; outline: none; align-self: flex-start; }

.kd-checkbox-input.is-disabled .kd-checkbox-inner { cursor: not-allowed; background-color: var(--kd-color-fill-light); border-color: var(--kd-color-line-light); }

.kd-checkbox-input.is-disabled .kd-checkbox-inner::after { cursor: not-allowed; border-color: var(--kd-color-icon-white); }

