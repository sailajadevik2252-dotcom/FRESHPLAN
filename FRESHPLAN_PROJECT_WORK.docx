.component-recorder-tip .recorder-tip-top { display: flex; justify-content: center; align-items: center; height: 100%; }

.component-recorder-tip .recorder-tip-top .remain-time { font-size: 24px; }

.component-recorder-tip .recorder-tip-top .remain-time::after { content: "\""; position: absolute; }

