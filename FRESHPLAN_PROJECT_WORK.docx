.css-1tqg64p { width: 100%; padding: 16px 0px; box-sizing: border-box; position: fixed; left: 0px; bottom: 0px; display: flex; -webkit-box-pack: center; justify-content: center; background: rgba(255, 255, 255, 0.8); box-shadow: rgba(154, 171, 233, 0.16) 0px -12px 64px 0px; backdrop-filter: blur(20px); z-index: 9999; font-family: "Noto Sans", "Segoe UI", Avenir, Helvetica, Arial, sans-serif; }

.css-1tqg64p .wrapper { position: relative; width: 90%; margin: 0px auto; display: flex; -webkit-box-pack: center; justify-content: center; -webkit-box-align: center; align-items: center; }

.css-1tqg64p .wrapper .info { flex: 1 1 0%; font-size: 14px; color: rgb(0, 0, 0); line-height: 21px; margin-right: 30px; font-weight: 400; }

.css-1tqg64p .wrapper .button-primary { flex: 0 0 150px; padding: 0px 16px; height: 38px; box-sizing: border-box; font-size: 14px; color: rgb(255, 255, 255); background: rgb(51, 51, 51); border-radius: 8px; cursor: pointer; margin-right: 12px; font-family: "Noto Sans", "Segoe UI", Avenir, Helvetica, Arial, sans-serif; transition: transform 0.3s ease-in-out; }

.css-1tqg64p .wrapper .button-primary:hover { transform: translateY(-3px); z-index: 200; box-shadow: rgba(0, 0, 0, 0.05) 0px 0px 8px 29px inset !important; }

.css-1tqg64p .wrapper .button-secondary { display: flex; flex: 0 0 240px; -webkit-box-align: center; align-items: center; -webkit-box-pack: center; justify-content: center; height: 38px; box-sizing: border-box; font-size: 14px; font-weight: 500; color: rgb(0, 0, 0); cursor: pointer; margin-top: 0px; text-align: center; border-radius: 8px; border: 1px solid rgb(51, 51, 51); }

.css-1tqg64p .wrapper .link { color: rgb(0, 0, 0); font-weight: 700; cursor: pointer; text-decoration: underline; }

@media screen and (max-width: 992px) {
  .css-1tqg64p { padding: 16px; flex-direction: column; border-radius: 16px 16px 0px 0px; text-align: left; }
  .css-1tqg64p .wrapper { width: 90%; display: block; }
  .css-1tqg64p .wrapper .info { flex: 0 0 auto; font-size: 12px; line-height: 22px; width: 100%; margin: 0px auto; max-width: 992px; }
  .css-1tqg64p .wrapper .button-primary { flex: 0 0 auto; width: 100%; text-align: center; display: inline-block; margin-top: 16px; height: 44px; line-height: 44px; font-weight: 700; }
  .css-1tqg64p .wrapper .button-secondary { display: inline-block; flex: 0 0 auto; width: 100%; margin-left: 0px; margin-top: 16px; height: 22px; line-height: 22px; border: 0px; }
}

.css-1h1hr2j { width: 100vw; height: 100vh; position: fixed; top: 0px; left: 0px; background: rgba(0, 0, 0, 0.7); z-index: 10000; display: flex; -webkit-box-pack: center; justify-content: center; -webkit-box-align: center; align-items: center; font-family: "Noto Sans", "Segoe UI", Avenir, Helvetica, Arial, sans-serif; }

.css-1h1hr2j .box { background: rgb(255, 255, 255); display: flex; flex-direction: column; border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.1) 0px 8px 20px 0px; box-sizing: border-box; }

.css-1h1hr2j .box .title { position: relative; height: 60px; line-height: 60px; font-size: 18px; color: rgba(0, 0, 0, 0.8); border-bottom: 1px solid rgba(0, 0, 0, 0.05); padding-left: 28px; font-weight: 700; }

.css-1h1hr2j .box .title .close-btn { position: absolute; right: 20px; top: 20px; width: 24px; height: 24px; line-height: 24px; font-size: 24px; cursor: pointer; }

.css-1h1hr2j .box .content { width: 560px; box-sizing: border-box; padding: 0px 28px 10px; }

.css-1h1hr2j .box .content .item { border-bottom: 1px solid rgba(0, 0, 0, 0.05); padding: 16px 0px 22px; }

.css-1h1hr2j .box .content .item:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.css-1h1hr2j .box .content .item .item-title { margin-bottom: 10px; }

.css-1h1hr2j .box .content .item .item-title .item-text { font-size: 14px; color: rgba(0, 0, 0, 0.8); font-weight: 600; }

.css-1h1hr2j .box .content .item .item-title .right-text { font-size: 12px; color: rgba(0, 0, 0, 0.8); float: right; font-weight: 600; }

.css-1h1hr2j .box .content .item .item-desc { font-size: 12px; font-weight: 400; color: rgba(0, 0, 0, 0.6); line-height: 17px; }

.css-1h1hr2j .box .content .item .item-link { color: rgb(0, 0, 0); font-weight: 700; cursor: pointer; text-decoration: underline; }

.css-1h1hr2j .box .bottom { text-align: right; border-top: 1px solid rgba(0, 0, 0, 0.05); padding: 18px 0px; }

.css-1h1hr2j .box .bottom .button { height: 42px; line-height: 42px; border-radius: 6px; margin-left: 16px; padding: 0px 24px; cursor: pointer; }

.css-1h1hr2j .box .bottom .button.black { background: rgb(51, 50, 49); color: rgb(255, 255, 255); }

.css-1h1hr2j .box .bottom .button.white { color: rgb(51, 50, 49); background: rgb(255, 255, 255); border: 1px solid rgba(0, 0, 0, 0.1); }

.css-xvlc3d { width: 32px; height: 16px; border-radius: 100px; cursor: pointer; background: rgba(0, 0, 0, 0.15); text-align: left; }

.css-xvlc3d.on { text-align: right; background: rgb(51, 50, 49); }

.css-xvlc3d .dot { display: inline-block; width: 12px; height: 12px; margin-top: 2px; background: rgb(255, 255, 255); border-radius: 50%; }
