.popup-container .feature-section-landscape[data-v-50cf9c86] { display: none; }

.popup-container .feature-section-normal[data-v-50cf9c86] { display: flex; }

@media (orientation: landscape) {
  .popup-container[data-v-50cf9c86] { overflow: hidden; }
  .popup-container .feature-section-landscape[data-v-50cf9c86] { display: flex; }
  .popup-container .feature-section-normal[data-v-50cf9c86] { display: none; }
}

.edit-with-wps-footer[data-v-50cf9c86] { position: relative; border-radius: 24px; background: rgb(255, 255, 255); border-top: 1px solid rgb(222, 222, 222); }

.edit-with-wps-footer .top-container[data-v-50cf9c86] { width: 100%; height: 36px; display: flex; justify-content: flex-end; padding: 12px 16px 0px 0px; }

.edit-with-wps-footer .close-button[data-v-50cf9c86] { width: 20px; height: 20px; cursor: pointer; z-index: 10; }

.edit-with-wps-footer .close-button .close-icon[data-v-50cf9c86] { width: 100%; height: 100%; display: flex; justify-content: center; align-items: center; }

.edit-with-wps-footer .close-button .close-icon img[data-v-50cf9c86] { width: 100%; height: 100%; }

.edit-with-wps-footer .content-container[data-v-50cf9c86] { padding: 0px 0px 24px 24px; display: flex; flex-direction: column; gap: 24px; max-height: calc(-100px + 100vh); overflow: hidden; }

@media (orientation: landscape) {
  .edit-with-wps-footer .content-container[data-v-50cf9c86] { flex-direction: row; overflow: hidden; padding: 0px; gap: 0px; }
}

.edit-with-wps-footer .app-install-section[data-v-50cf9c86] { display: flex; flex-direction: column; gap: 24px; }

@media (orientation: landscape) {
  .edit-with-wps-footer .app-install-section[data-v-50cf9c86] { overflow-y: auto; padding: 0px 48px 24px; min-width: 408px; }
}

.edit-with-wps-footer .feature-section[data-v-50cf9c86] { padding-right: 24px; }

@media (orientation: landscape) {
  .edit-with-wps-footer .feature-section[data-v-50cf9c86] { flex: 1 1 0%; overflow-y: auto; }
}

.edit-with-wps-footer .description-text[data-v-50cf9c86] { font-weight: 400; font-size: 12px; line-height: 16px; color: rgb(73, 69, 79); margin: 0px; text-align: left; }

.edit-with-wps-footer .action-buttons[data-v-50cf9c86] { display: flex; gap: 12px; width: 100%; padding-right: 24px; }

@media (orientation: landscape) {
  .edit-with-wps-footer .action-buttons[data-v-50cf9c86] { padding-right: 0px; }
}

.edit-with-wps-footer .action-buttons .primary-button[data-v-50cf9c86], .edit-with-wps-footer .action-buttons .secondary-button[data-v-50cf9c86] { flex: 1 1 0%; height: 32px; border-radius: 5px; font-weight: 400; font-size: 14px; line-height: 22px; text-align: center; cursor: pointer; transition: 0.2s; border: 1px solid transparent; padding: 4px 15px; }

.edit-with-wps-footer .action-buttons .primary-button[data-v-50cf9c86]:focus, .edit-with-wps-footer .action-buttons .secondary-button[data-v-50cf9c86]:focus { outline: none; }

.edit-with-wps-footer .action-buttons .secondary-button[data-v-50cf9c86] { background: rgb(255, 255, 255); border: 1px solid rgba(13, 13, 13, 0.12); color: rgba(13, 13, 13, 0.9); }

.edit-with-wps-footer .action-buttons .secondary-button[data-v-50cf9c86]:hover { background: rgb(248, 248, 248); border-color: rgba(13, 13, 13, 0.16); }

.edit-with-wps-footer .action-buttons .secondary-button[data-v-50cf9c86]:active { background: rgb(240, 240, 240); border-color: rgba(13, 13, 13, 0.2); }

.edit-with-wps-footer .action-buttons .primary-button[data-v-50cf9c86] { background: rgb(31, 105, 224); border: 1px solid rgb(31, 105, 224); color: rgb(255, 255, 255); }

.edit-with-wps-footer .action-buttons .primary-button[data-v-50cf9c86]:hover { background: rgb(21, 87, 199); border-color: rgb(21, 87, 199); }

.edit-with-wps-footer .action-buttons .primary-button[data-v-50cf9c86]:active { background: rgb(15, 74, 171); border-color: rgb(15, 74, 171); }
