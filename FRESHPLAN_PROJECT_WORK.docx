  100% { opacity: 1; transform: translateZ(0px); }
}

@keyframes fadeOut { 
  0% { opacity: 1; transform: translateZ(0px); }
  100% { opacity: 0; transform: translate3d(0px, -20px, 0px); }
}

@keyframes bounceIn { 
  0% { opacity: 0; transform: scale3d(0.3, 0.3, 0.3); }
  100% { opacity: 1; transform: scaleX(1); }
