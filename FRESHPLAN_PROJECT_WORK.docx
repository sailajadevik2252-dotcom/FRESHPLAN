.shape-video-player .video-control .top .more { visibility: hidden; }

.shape-video-player .video-control .top.active { opacity: 1; transform: translateY(0px); pointer-events: unset; }

.shape-video-player .video-control .bottom { box-sizing: border-box; padding: 0px 15px; height: 55px; width: 100%; background: linear-gradient(0deg, rgba(0, 0, 0, 0.6), transparent); display: flex; flex-direction: column; opacity: 0; transform: translateY(100%); pointer-events: none; z-index: 3; }

.shape-video-player .video-control .bottom.hidden { display: none; }

.shape-video-player .video-control .bottom .panel { margin-top: 5px; }

