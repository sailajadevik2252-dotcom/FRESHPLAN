.banner-title-wrapper[data-v-2cb62af8] { position: relative; display: flex; flex-direction: column; width: 100%; height: 56vw; max-height: 50vh; padding-top: 24px; background: linear-gradient(128.42deg, rgba(108, 39, 255, 0.07) 20.68%, rgba(140, 193, 255, 0.12) 93.91%); }

.banner-title-wrapper .banner-title[data-v-2cb62af8] { display: flex; flex-direction: column; justify-content: center; align-items: center; }

.banner-title-wrapper .banner-title .color-title-wrapper[data-v-2cb62af8] { display: flex; align-items: center; height: 24px; line-height: 24px; }

.banner-title-wrapper .banner-title .color-title-wrapper .ai-icon[data-v-2cb62af8] { width: 24px; height: 24px; background-image: url("https://global-static.wpscdn.com/cms/docs/img/colorAi.4dbb564.svg"); }

.banner-title-wrapper .banner-title .color-title-wrapper .color-title[data-v-2cb62af8] { margin-left: 4px; font-size: 18px; font-weight: 700; color: rgb(104, 42, 239); }

.banner-title-wrapper .banner-image[data-v-2cb62af8] { flex: 1 1 0%; background-image: url("https://global-static.wpscdn.com/cms/docs/img/ai1.83be940.png"); }

.banner-title-wrapper .close-icon[data-v-2cb62af8] { position: absolute; top: 16px; right: 16px; width: 20px; height: 20px; cursor: pointer; background: url("data:image/svg+xml;base64,"); }

.banner-content .banner-hint[data-v-2cb62af8] { display: flex; align-items: center; margin: 20px 24px; font-size: 14px; font-weight: 500; color: rgba(13, 13, 13, 0.66); }

.banner-content .banner-hint .hint-text[data-v-2cb62af8] { padding: 0px 12px; }

.banner-content .banner-hint .line[data-v-2cb62af8] { flex: 1 1 0%; height: 1px; background-color: rgba(13, 13, 13, 0.06); }

.banner-content .banner-links[data-v-2cb62af8] { display: flex; justify-content: space-around; align-items: flex-start; margin-bottom: 30px; }

.banner-content .banner-links .banner-link[data-v-2cb62af8] { flex: 1 1 0%; }

.banner-content .banner-links .banner-link .link-icon[data-v-2cb62af8] { width: 14vw; height: 14vw; max-width: 50px; max-height: 50px; margin: 0px auto; }

.banner-content .banner-links .banner-link .link-title[data-v-2cb62af8] { margin-top: 8px; font-size: 12px; font-weight: 400; line-height: 16px; text-align: center; color: rgba(0, 0, 0, 0.4); }
