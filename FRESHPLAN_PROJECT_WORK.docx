.player-progress.vertical { height: 100%; width: unset; }

.player-progress.vertical .progress-duration { width: 4px; height: 100%; display: flex; flex-direction: column-reverse; }

.player-progress.vertical .progress-duration .progress-current { width: 100%; height: unset; }

.player-progress.vertical .progress-duration .progress-current .progress-control { top: unset; left: 50%; transform: translate(-50%, -50%); }

.player-volume .player-volume-btn { cursor: pointer; }

