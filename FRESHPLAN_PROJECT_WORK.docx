.player-volume-panel { position: relative; width: 45px; height: 165px; border-radius: 8px; display: flex; flex-direction: column; align-items: center; padding: 10px 5px; background: rgb(255, 255, 255); box-shadow: rgba(13, 13, 13, 0.08) 0px 12px 32px 0px; border: 1px solid var(--kd-color-line-regular); z-index: 99; transform: translateX(35%); }

