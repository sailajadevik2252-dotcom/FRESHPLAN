[dir="rtl"] .kd-icon-rtl-variant:not(.kd-icon-dir-ltr):not(.kd-icon-dir-rtl) { --kd-visibility-dir-ltr: hidden; --kd-visibility-dir-rtl: visible; }

@keyframes kd-icon-spin { 
  100% { transform: rotate(1turn); }
}

.kd-icon { display: inline-block; font-size: 0px; line-height: 1; vertical-align: middle; background-repeat: no-repeat; background-size: 100% 100%; flex-shrink: 0; }

@keyframes spinning-ltr { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

@keyframes spinning-rtl { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(-1turn); }
}

.qq-browser-header { position: absolute; top: 0px; left: 0px; width: 100vw; height: 40px; line-height: 40px; font-size: 14px; background: rgb(246, 246, 246); border-bottom: 1px solid rgb(221, 221, 221); z-index: 2; }

.qq-browser-header .exit { padding-left: 12px; }

.qq-browser-header .undo { position: absolute; right: 64px; height: 40px; line-height: 40px; }

.qq-browser-header .save { position: absolute; right: 12px; height: 40px; line-height: 40px; color: rgb(73, 145, 242); }

.is-page-mode { background: rgb(242, 244, 247); }

.fullscreen-adaptor { position: fixed; bottom: 0px; left: 0px; width: 100vw; background: rgb(255, 255, 255); z-index: 1; height: env(safe-area-inset-bottom,0); }

.scrollbar-outer-wrapper { position: absolute; inset: 0px; z-index: 1; }

.scrollbar-outer-wrapper .scrollbar-inner-wrapper { position: relative; display: inline-block; top: 0px; left: 0px; overflow: hidden; }

.scrollbar-outer-wrapper .scroll-bar { z-index: 100; }

.scrollbar-outer-wrapper .scroll-bar.hide { opacity: 0; }

.scrollbar-outer-wrapper .scroll-bar-x { position: absolute; left: 0px; bottom: 5px; height: 4px; opacity: 0.7; }

.scrollbar-outer-wrapper .scroll-bar-x::before { display: block; content: ""; width: calc(100% - 4px); height: 100%; margin: 0px 2px; background: rgb(193, 193, 193); border-radius: 2px; }

.scrollbar-outer-wrapper .scroll-bar-y { position: absolute; top: 0px; right: 4px; width: 20px; opacity: 0.7; }

.scrollbar-outer-wrapper .scroll-bar-y::before { display: block; content: ""; width: 6px; height: calc(100% - 4px); margin: 2px 0px 2px 14px; background: rgb(193, 193, 193); border-radius: 2px; }

.scrollbar-outer-wrapper .scroll-bar-y:not(.scrollbar-outer-wrapper .scroll-bar-y.highlight)::before { background: var(--kd-color-fill-heavy,#dbdbdb); }

.scrollbar-outer-wrapper .scroll-bar-y.highlight::before { background: var(--kd-color-fill-extra-heavy,#ccc); }

.animation-fade-in-left { animation: 0.2s ease 0s 1 normal none running fadeInLeft; }

@keyframes fadeInLeft { 
  0% { opacity: 0; transform: translate3d(100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

#guide_container { position: absolute; bottom: 56px; max-height: 100px; width: 100%; z-index: 2; transform: translateY(0px); transition: transform 0.3s linear; }

#guide_container.hide { display: none; }

#guide_container.fade { transform: translateY(200px) !important; }

.animation-fade-in-left { animation: 0.2s ease 0s 1 normal none running fadeInLeft; }

@keyframes fadeInLeft { 
  0% { opacity: 0; transform: translate3d(100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

#top-banner { position: fixed; top: 48px; width: 100%; height: 0px; max-height: 100px; z-index: 2; transform: translateY(0px); transition: transform 0.3s linear; }

#top-banner.hide { display: none; }

#top-banner.fade { transform: scale(0) !important; }

.wps-context-menu { max-width: 520px; padding: 0px; box-shadow: rgba(13, 13, 13, 0.2) 0px 16px 48px 0px; }

.wps-context-menu.component-context-menu { overflow: hidden; padding: 0px; z-index: 999; }

.wps-context-menu.component-context-menu.hide { display: none; }

.wps-context-menu.component-context-menu .context-menu-container { width: 100%; }

