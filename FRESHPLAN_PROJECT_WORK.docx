------MultipartBoundary--I3yG6XVhTcTGkyKy038XMBGlS5t74F60Eg08sLKCfM----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://global-static.wpscdn.com/docs/weboffice-static/js/chunk/writer/components/mobile/other/FontDownloadNotification.94a60bdf.en-US.css

@charset "utf-8";

.wps-font-download-dialog .confirm-body { width: 281px; }

.wps-font-download-dialog .confirm-body .confirm-content { padding: 24px; }

.wps-font-download-dialog.error-notice .content { display: flex; flex-direction: column; justify-content: center; width: 100%; align-items: center; }

.wps-font-download-dialog.error-notice .content .warning-icon { width: 36px; height: 36px; }

.wps-font-download-dialog.error-notice .content .first-line { font-size: 18px; line-height: 25px; font-weight: 500; }

.wps-font-download-dialog.error-notice .content .second-line { font-size: 15px; line-height: 22px; opacity: 0.6; }

.wps-font-download-notification-entry { font-size: 12px; height: 40px; color: rgb(0, 0, 0); padding: 0px 12px; display: flex; align-items: center; }

.wps-font-download-notification-entry span { margin-right: auto; display: inline-block; }

.wps-font-download-notification-entry .download-btn { background-color: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(65, 127, 249); margin-right: 8px; }

.wps-font-download-progress-bar { width: 100%; height: 40px; font-size: 12px; color: rgba(0, 0, 0, 0.4); padding: 0px 12px; display: flex; justify-content: space-between; align-items: center; }

.wps-font-download-progress-bar .progress-bar { padding: 0px 24px 0px 12px; flex: 2 1 0%; display: flex; align-items: center; }

.wps-font-download-progress-bar .progress-bar .bar { appearance: none; width: 100%; }

.wps-font-download-progress-bar .bar, .wps-font-download-progress-bar .bar::-webkit-progress-bar { border: 0px; height: 4px; border-radius: 2px; background: rgba(0, 0, 0, 0.08); }

.wps-font-download-progress-bar .bar::-webkit-progress-value { border: 0px; height: 4px; border-radius: 2px; }

.wps-font-download-progress-bar .wps::-webkit-progress-value { background-color: rgb(65, 130, 217); }

.wps-font-download-notification { width: 100%; position: fixed; margin: 0px auto; left: 0px; right: 0px; z-index: 1040; display: flex; justify-content: center; }

.wps-font-download-notification-body { width: 90%; top: 58px; background-color: rgb(255, 255, 255); box-shadow: rgba(9, 23, 49, 0.21) 0px 2px 6px 0px; opacity: 0; visibility: hidden; transform: translateY(-50%); position: relative; }

.wps-font-download-notification-body.is-visible { visibility: visible; transition: opacity 0.2s, transform 0.2s; opacity: 1; transform: translate(0px); }
------MultipartBoundary--I3yG6XVhTcTGkyKy038XMBGlS5t74F60Eg08sLKCfM----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://global-static.wpscdn.com/docs/weboffice-static/js/chunk/writer/core/openapi.ade6601f.en-US.css

@charset "utf-8";

.kd-message { display: inline-block; padding: 9px 20px; overflow: hidden; vertical-align: top; pointer-events: all; background-color: var(--kd-color-background-top); border: 1px solid var(--kd-color-line-regular); border-radius: var(--kd-border-radius-large); box-shadow: var(--kd-box-shadow-large); box-sizing: border-box; }

.kd-message-root { position: fixed; top: 0px; left: 0px; z-index: var(--kd-z-index-reminder); width: 100%; padding-top: 88px; pointer-events: none; }

[dir="rtl"] .kd-message-root { left: auto; right: 0px; }

.kd-message-wrap { padding: 8px; text-align: center; }

.kd-message-wrap.custom-top { position: absolute; z-index: var(--kd-z-index-reminder); width: 100%; }

.kd-message-group { line-height: 22px; }

.kd-message-group, .kd-message-icon { position: relative; display: flex; align-items: flex-start; }

.kd-message-icon { top: 3px; }

.kd-message-icon .icon-loading { width: 16px; height: 16px; background: url("data:image/svg+xml;base64,") 0% 0% / 100% 100% no-repeat; animation: 0.8s linear 0s infinite normal none running spinning; }

.kd-message-icon + .kd-message-text { margin-left: 8px; }

[dir="rtl"] .kd-message-icon + .kd-message-text { margin-left: 0px; margin-right: 8px; }

.kd-message-text { font-size: var(--kd-font-size-sub-base); color: var(--kd-color-text-primary); text-align: justify; white-space: normal; }

.kd-message .kd-message-close { margin-left: 16px; cursor: pointer; }

[dir="rtl"] .kd-message .kd-message-close { margin-left: 0px; margin-right: 16px; }

.kd-message .kd-message-close .kd-color-icon-primary { fill: var(--kd-color-icon-secondary); stroke: var(--kd-color-icon-secondary); }

.kd-message-info { background-color: var(--kd-color-public-light); border-color: var(--kd-color-public-normal); }

.kd-message-success { background-color: var(--kd-color-success-light); border-color: var(--kd-color-success-normal); }

.kd-message-warning { background-color: var(--kd-color-warning-light); border-color: var(--kd-color-warning-normal); }

.kd-message-error { background-color: var(--kd-color-error-light); border-color: var(--kd-color-error-normal); }

.kd-message-loading { background-color: var(--kd-color-public-light); border-color: var(--kd-color-public-normal); }

.kd-message-fade-enter-active { animation: 0.3s ease 0s 1 normal both running toast-fade-in; }

.kd-message-fade-exit { animation: 0.3s ease 0s 1 normal both running toast-fade-out; }

@keyframes toast-fade-in { 
  0% { padding: 0px; opacity: 0; transform: translateY(-90%); }
  100% { padding: 8px; opacity: 1; transform: translateY(0px); }
}

@keyframes toast-fade-out { 
  0% { max-height: 150px; padding: 8px; opacity: 1; }
  100% { max-height: 0px; padding: 0px; opacity: 0; }
}

@keyframes rotation-ltr { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

@keyframes rotation-rtl { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(-1turn); }
}

.kd-icon { display: inline-block; color: inherit; font-style: normal; line-height: 0; text-align: center; text-transform: none; text-rendering: optimizelegibility; -webkit-font-smoothing: antialiased; }

.kd-icon-spin svg { animation: 1s linear 0s infinite normal none running kd-icon-spin; }

.kd-icon-rtl-mirror.kd-icon-dir-rtl svg { transform: scaleX(-1); }

.kd-icon-rtl-variant { --kd-visibility-dir-ltr: visible; --kd-visibility-dir-rtl: hidden; }

.kd-icon-rtl-variant.kd-icon-dir-rtl { --kd-visibility-dir-ltr: hidden; --kd-visibility-dir-rtl: visible; }

.kd-icon-rtl-variant.kd-icon-dir-ltr { --kd-visibility-dir-ltr: visible; --kd-visibility-dir-rtl: hidden; }

[dir="rtl"] .kd-icon-rtl-mirror:not(.kd-icon-dir-ltr):not(.kd-icon-dir-rtl) svg { transform: scaleX(-1); }

[dir="rtl"] .kd-icon-rtl-variant:not(.kd-icon-dir-ltr):not(.kd-icon-dir-rtl) { --kd-visibility-dir-ltr: hidden; --kd-visibility-dir-rtl: visible; }

@keyframes kd-icon-spin { 
  100% { transform: rotate(1turn); }
}

.kd-icon { display: inline-block; font-size: 0px; line-height: 1; vertical-align: middle; background-repeat: no-repeat; background-size: 100% 100%; flex-shrink: 0; }

@keyframes spinning-ltr { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

@keyframes spinning-rtl { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(-1turn); }
}

.kd-button { position: relative; display: inline-flex; max-width: 100%; margin: 0px; font-family: inherit; font-size: var(--kd-font-size-sub-base); font-weight: 400; line-height: 22px; text-align: center; white-space: nowrap; vertical-align: middle; cursor: pointer; background: transparent; border: 1px solid transparent; border-radius: var(--kd-border-radius-middle); outline: none; justify-content: center; align-items: center; box-sizing: border-box; appearance: none; user-select: none; }

.kd-button .kd-icon { display: inline-block; font-size: 16px; vertical-align: middle; }

.kd-button .kd-button-children { display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.kd-button-children + .kd-button-suffix-icon, .kd-icon + .kd-button-children { margin-left: 4px; }

[dir="rtl"] .kd-button-children + .kd-button-suffix-icon, [dir="rtl"] .kd-icon + .kd-button-children { margin-left: 0px; margin-right: 4px; }

.kd-button[disabled] { cursor: not-allowed; }

.kd-button-loading { pointer-events: none; cursor: unset; }

.kd-button-loading, .kd-button[disabled] { opacity: var(--kd-opacity-disabled); }

.kd-button-sm { height: 24px; padding: 0px 5px; border-radius: var(--kd-border-radius-small); }

.kd-button-m { height: 28px; padding: 2px 11px; }

.kd-button-lg { height: 32px; padding: 4px 15px; }

.kd-button-xl { height: 36px; padding: 6px 19px; font-size: var(--kd-font-size-middle); }

