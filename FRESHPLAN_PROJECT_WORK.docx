.component-bottom-dialog .component-panel-item { background: rgb(255, 255, 255); flex-shrink: 0; }

.wo-button { display: inline-block; }

.wo-button.disabled { pointer-events: inherit; }

.wo-button.is-block, .wo-button .kd-button { width: 100%; }

.wo-button.with-theme { --kd-color-public-normal: var(--kd-color-brand-normal); --kd-color-public-hover: var(--kd-color-brand-hover); --kd-color-public-pressed: var(--kd-color-brand-pressed); --kd-color-public-light: var(--kd-color-brand-light); --kd-color-text-public: var(--kd-color-text-brand); --kd-color-state-pressed-public: var(--kd-color-state-pressed-brand); --kd-color-line-public: var(--kd-color-line-brand); --kd-color-icon-public: var(--kd-color-icon-brand); }

.wo-button .kd-icon { line-height: 0; }

.wo-button-xs .kd-button { height: 20px !important; }

.wo-button-xs .kd-button-icon { min-width: 20px !important; }

.kd-button { position: relative; display: inline-flex; max-width: 100%; margin: 0px; font-family: inherit; font-size: var(--kd-font-size-sub-base); font-weight: 400; line-height: 22px; text-align: center; white-space: nowrap; vertical-align: middle; cursor: pointer; background: transparent; border: 1px solid transparent; border-radius: var(--kd-border-radius-middle); outline: none; justify-content: center; align-items: center; box-sizing: border-box; appearance: none; user-select: none; }

.kd-button .kd-icon { display: inline-block; font-size: 16px; vertical-align: middle; }

.kd-button .kd-button-children { display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.kd-button-children + .kd-button-suffix-icon, .kd-icon + .kd-button-children { margin-left: 4px; }

[dir="rtl"] .kd-button-children + .kd-button-suffix-icon, [dir="rtl"] .kd-icon + .kd-button-children { margin-left: 0px; margin-right: 4px; }

.kd-button[disabled] { cursor: not-allowed; }

.kd-button-loading { pointer-events: none; cursor: unset; }

.kd-button-loading, .kd-button[disabled] { opacity: var(--kd-opacity-disabled); }

.kd-button-sm { height: 24px; padding: 0px 5px; border-radius: var(--kd-border-radius-small); }

.kd-button-m { height: 28px; padding: 2px 11px; }

.kd-button-lg { height: 32px; padding: 4px 15px; }

.kd-button-xl { height: 36px; padding: 6px 19px; font-size: var(--kd-font-size-middle); }

.kd-button-icon.is-compact, .kd-button-light.is-compact { padding: 2px; }

.kd-button-primary { color: var(--kd-color-text-white); background: var(--kd-color-public-normal); }

.kd-button-primary:hover { background: var(--kd-color-public-hover); }

.kd-button-primary:active { background: var(--kd-color-public-pressed); }

.kd-button-primary .kd-button-children.pure { min-width: 40px; }

.kd-button-primary.is-active { background: var(--kd-color-public-pressed); }

.kd-button-primary.kd-button-loading, .kd-button-primary[disabled] { background: var(--kd-color-public-normal); }

.kd-button-primary.kd-button-danger { background: var(--kd-color-error-normal); }

.kd-button-primary.kd-button-danger:hover { background: var(--kd-color-error-hover); }

.kd-button-primary.kd-button-danger.is-active, .kd-button-primary.kd-button-danger:active { background: var(--kd-color-error-pressed); }

.kd-button-primary.kd-button-danger.kd-button-loading, .kd-button-primary.kd-button-danger[disabled] { background: var(--kd-color-error-normal); }

.kd-button-primary .icon-dropdown .kd-color-icon-secondary { fill: currentcolor; stroke: currentcolor; }

.kd-button-secondary { color: var(--kd-color-text-primary); background: var(--kd-color-fill-base); border-color: var(--kd-color-line-regular); }

.kd-button-secondary:hover { background: var(--kd-color-fill-light); }

.kd-button-secondary:active { background: var(--kd-color-fill-regular); }

.kd-button-secondary .kd-button-children.pure { min-width: 40px; }

.kd-button-secondary.is-active { color: var(--kd-color-text-primary); background: var(--kd-color-fill-light); }

.kd-button-secondary.kd-button-loading, .kd-button-secondary[disabled] { background: var(--kd-color-fill-regular); border: 1px solid var(--kd-color-line-medium); box-shadow: none; }

.kd-button-secondary.kd-button-highlight { color: var(--kd-color-text-public); border: 1px solid var(--kd-color-line-public); box-shadow: none; }

.kd-button-secondary.kd-button-highlight:hover { background: var(--kd-color-fill-light); }

.kd-button-secondary.kd-button-highlight:active { background: var(--kd-color-fill-regular); }

