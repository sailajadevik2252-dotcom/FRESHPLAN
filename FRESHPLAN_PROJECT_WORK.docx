.wo-component-menu.selectable .component-menu-item { padding-left: 32px; }

.wo-component-menu .component-menu-item { flex-shrink: 0; flex-grow: 1; position: relative; padding: 5px 24px 5px 8px; line-height: 22px; border-radius: 6px; margin-top: 4px; font-size: var(--kd-font-size-sub-base); color: var(--kd-color-text-primary); display: flex; align-items: center; white-space: normal; }

.wo-component-menu .component-menu-item:first-child { margin-top: 0px; }

