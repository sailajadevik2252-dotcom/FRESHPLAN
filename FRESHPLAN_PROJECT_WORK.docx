.wps-context-menu.component-context-menu .first-row .context-menu-item .menu-content .menu-text .high-light-color { border-radius: 3px; display: flex; height: 24px; width: 24px; justify-content: center; align-items: center; }

.wps-context-menu.component-context-menu .first-row .context-menu-item.high-light .menu-content .menu-text { flex-direction: column; }

.wps-context-menu.component-context-menu .first-row .context-menu-item.high-light .menu-content .menu-text .high-light-text { padding-top: 2px; }

.wps-context-menu.component-context-menu .color-item .menu-content .menu-text { display: inline-flex; }

.wps-context-menu.component-context-menu .second-row { height: 50px; }

.wps-context-menu.component-context-menu .second-row .setting { display: inline-block; height: 100%; position: relative; }

.wps-context-menu.component-context-menu .second-row .setting .color-setting, .wps-context-menu.component-context-menu .second-row .setting .font-setting { height: 100%; overflow: hidden; position: absolute; left: 0px; top: 0px; background-color: rgb(255, 255, 255); width: 0px; transition: width 0.25s linear; z-index: 2; }

.wps-context-menu.component-context-menu .second-row .setting .color-setting.show, .wps-context-menu.component-context-menu .second-row .setting .font-setting.show { width: 290px; }

.wps-context-menu.component-context-menu .second-row .context-menu-item { height: 100%; }

.wps-context-menu.component-context-menu .second-row .context-menu-item .menu-content { display: flex; align-items: center; padding: 0px; }

