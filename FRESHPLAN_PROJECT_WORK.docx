.toast { position: fixed; bottom: 100px; left: 50%; box-sizing: border-box; max-width: 80%; line-height: 24px; padding: 9px 16px; transform: translateX(-50%); text-align: center; z-index: 9999; font-size: 14px; color: rgb(255, 255, 255); border-radius: 8px; background: rgba(0, 0, 0, 0.7); animation: 0.5s ease 0s 1 normal none running show-toast; }

.toast.word-wrap { width: 80%; white-space: inherit; height: auto; }

.toast.toast-top { top: 50px; bottom: inherit; }

.toast.toast-center { top: 50%; margin-top: -20px; bottom: inherit; }

@keyframes show-toast { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}
