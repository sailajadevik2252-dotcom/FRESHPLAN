.component-confirm .confirm-checkbox-text { font-size: 14px; color: var(---kd-color-text-secondary,hsla(0,0%,5%,.66)); line-height: 20px; }

.component-confirm .confirm-footer { position: relative; display: flex; align-items: center; flex-wrap: wrap; }

.component-confirm .confirm-footer::before { content: ""; position: absolute; left: 0px; right: 0px; top: 0px; height: 1px; background: rgb(217, 217, 217); transform: scaleY(0.5); transform-origin: left top; }

