:root, html { --kd-stroke-width-icon-regular: 1px !important; --kd-stroke-width-icon-bold: 1.2px !important; }

:root .wo-cmb-tab, html .wo-cmb-tab { --kd-stroke-width-icon-regular: 1.2px !important; --kd-stroke-width-icon-bold: 1.2px !important; }

html, html[theme-mode="light"] { --svg-icon-filter: none; }

html[theme-mode="dark"] { --svg-icon-filter: invert(1) hue-rotate(180deg) contrast(0.9); }

#wo-common-header .kd-button-light .kd-icon.menu-icon, .public-svg-icon-filter .icons { filter: var(--svg-icon-filter); }

.embed-container .loading-page, .embed-container .loading-page-custom, .embed-container .loading-page-mask, .embed-container .loading-progress-wrap { display: none; }

.queryinit-exec-detail { font-size: 12px; color: var(--kd-color-text-tertiary); margin-top: 10px; display: inline-block; }

.loading-page-mask { position: fixed; inset: 0px; z-index: 1051; }

.kd-new-ui .loading-page-mask, .loading-page-mask { background: var(--kd-color-background-base); }

.theme-b .loading-page-mask, .theme-i .loading-page-mask { background: var(--kd-color-background-plate); }

.loading-page, .loading-page-custom { position: fixed; inset: 0px; z-index: 1051; display: flex; flex-direction: column; justify-content: center; align-items: center; }

.loading-page.loading-done .bar-right { transform: rotate(45deg) !important; }

.loading-page.loading-done .bar-left { transform: rotate(405deg) !important; }

.loading-page.loop-loading .circle-wrap { animation: 1s linear 0s infinite normal none running loop-loading-rotate; }

.loading-page.loop-loading .circle-wrap .progress-bar.bar-right { transform: rotate(0deg); }

.loading-page .loading-wrap { display: flex; align-items: center; justify-content: center; flex-direction: column; flex-grow: 1; }

.loading-page .logo-wrap { text-align: center; margin-bottom: 10px; }

.loading-page .logo-wrap img { display: inline-block; vertical-align: top; max-width: 300px; width: 80%; }

.loading-page .logo-wrap .logo-title { font-weight: 600; font-size: 16px; line-height: 100%; letter-spacing: 0px; margin-bottom: 5px; }

.loading-page .logo-wrap .logo-title-mobile { font-weight: 600; font-size: 20px; line-height: 100%; letter-spacing: 0px; margin-bottom: 5px; }

.loading-page .loading-title { font-size: 28px; text-align: center; white-space: pre-wrap; }

.loading-page .loading-subtitle { font-size: 16px; line-height: 33px; color: var(--kd-color-text-secondary); text-align: center; white-space: pre-wrap; }

.loading-page .circle-wrap { position: relative; width: 36px; height: 36px; background: rgb(231, 233, 235); border-radius: 50%; margin-top: 46px; }

.loading-page .circle-wrap .semicircle { position: absolute; top: 0px; width: 18px; height: 36px; overflow: hidden; }

.loading-page .circle-wrap .semicircle.semicircle-right { right: 0px; }

.loading-page .circle-wrap .semicircle.semicircle-left { left: 0px; }

.loading-page .circle-wrap .progress-bar { position: absolute; top: 0px; width: 28px; height: 28px; border-radius: 50%; border: 4px solid transparent; box-sizing: content-box; }

.loading-page .circle-wrap .progress-bar.bar-right { right: 0px; border-top: 4px solid rgb(65, 127, 249); border-right: 4px solid rgb(65, 127, 249); transform: rotate(-134deg); }

.loading-page .circle-wrap .progress-bar.bar-left { left: 0px; border-bottom: 4px solid rgb(65, 127, 249); border-left: 4px solid rgb(65, 127, 249); transform: rotate(-136deg); }

.loading-page .circle-wrap .fillet-circle { position: absolute; inset: 4px; background: rgb(255, 255, 255); border-radius: 50%; }

.loading-page .footer-wrap { display: flex; justify-content: center; align-items: center; position: absolute; left: 0px; right: 0px; bottom: 30px; }

.loading-page.mini-loading .footer-wrap, .loading-page.mini-loading .loading-subtitle, .loading-page.mini-loading .loading-title, .loading-page.mini-loading .logo-wrap { display: none; }

.loading-page.mini-loading .circle-wrap { margin-top: 0px; }

.loading-page.mini-loading .loading-wrap { width: 60px; height: 60px; background: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.08) 0px 2px 8px 0px; border-radius: 4px; flex-grow: 0; }

.loading-page-custom .loading-wrap { position: relative; }

.loading-page-custom .banner-wrap img, .loading-page-custom .footer-wrap img { object-fit: contain; }

.loading-page-custom .circle-wrap, .loading-page-custom .footer-wrap { position: absolute; }

.loading-page-custom.loop-loading .circle-wrap { animation: 1s linear 0s infinite normal none running loop-loading-rotate; }

.tip-wrap { width: 378px; height: 72px; padding: 24px 0px; gap: 12px; display: flex; align-items: center; justify-content: center; }

.tip-wrap .loading-tip { height: 100%; display: flex; align-items: center; justify-self: center; text-decoration: none; color: inherit; }

.tip-wrap .is-clickable { cursor: pointer; }

.tip-wrap .tips-img { width: 16px; height: 16px; margin: 8px; }

.tip-wrap .tips-text { max-width: 288px; height: 24px; font-weight: 400; font-size: 16px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "PingFang SC", "Noto Sans", "Noto Sans CJK SC", "Microsoft YaHei", å¾®è½¯é›…é»‘, sans-serif; line-height: 24px; text-align: center; color: rgba(13, 13, 13, 0.9); }

.tip-wrap .tips-text-mobile { max-width: 252px; height: 22px; font-weight: 400; font-size: 14px; line-height: 22px; text-align: center; color: rgba(13, 13, 13, 0.66); }

.tip-wrap-mobile { position: absolute; bottom: 50px; }

@keyframes loop-loading-rotate { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

.pad .loading-page:not(.mini-loading) .loading-wrap, .pc .loading-page:not(.mini-loading) .loading-wrap { width: 400px; height: 300px; background: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.04) 0px 4px 8px 0px; border-radius: 2px; flex-grow: 0; }

.pad .loading-page:not(.mini-loading) .loading-wrap img, .pc .loading-page:not(.mini-loading) .loading-wrap img { width: 200px; max-width: 200px; }

.pad .loading-page:not(.mini-loading) .loading-subtitle, .pc .loading-page:not(.mini-loading) .loading-subtitle { font-size: 12px; line-height: 20px; margin-top: 5px; }

.pad .loading-page:not(.mini-loading) .logo-wrap, .pc .loading-page:not(.mini-loading) .logo-wrap { margin-bottom: 0px; }

.pad .loading-page:not(.mini-loading) .circle-wrap, .pc .loading-page:not(.mini-loading) .circle-wrap { margin-top: 18px; }

.mobile .loading-page-mask { background: rgb(255, 255, 255); }

.mobile .loading-page-custom .loading-wrap { width: 100%; display: flex; flex-direction: column; align-items: center; }

.mobile .loading-page-custom .footer-wrap { margin: 0px auto; }

.loading-page.auto-loading:not(.mini-loading) .logo-wrap img { width: 100%; }

.loading-page.auto-loading:not(.mini-loading) .loading-title { font-size: 26px; line-height: 58px; }

.loading-page.auto-loading:not(.mini-loading) .loading-subtitle { font-size: 18px; line-height: 30px; color: initial; margin-top: 0px; }

.loading-page.auto-loading:not(.mini-loading).loading-title-small .loading-title { line-height: 33px; }

.loading-page.auto-loading:not(.mini-loading).loading-title-small .loading-subtitle { font-size: 10px; line-height: 26px; }

.loading-page.auto-loading:not(.mini-loading) .logo-wrap { margin-bottom: 10px; }

.loading-page.auto-loading:not(.mini-loading) .circle-wrap { margin-top: 24px; }

@media screen and (max-height: 480px) {
  .pc .loading-page:not(.mini-loading) .loading-wrap { width: 60px; height: 60px; }
  .pc .loading-page:not(.mini-loading) .circle-wrap { margin-top: 0px; }
  .pc .loading-page:not(.mini-loading) .loading-subtitle, .pc .loading-page:not(.mini-loading) .loading-title, .pc .loading-page:not(.mini-loading) .logo-wrap { display: none; }
}

.loading-progress-wrap { position: fixed; inset: 0px; display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 1052; }

.loading-progress-wrap .loading-progress-circle-container { position: relative; width: 100px; height: 100px; }

.loading-progress-wrap .loading-progress { width: 100px; height: 100px; display: flex; justify-content: center; align-items: center; transform: rotate(-90deg); }

.loading-progress-wrap .loading-progress .loading-progress-circle { animation: 1s linear 0s infinite normal none running loading-circle; fill: none; stroke: rgb(31, 105, 224); stroke-width: 5; stroke-linecap: round; }

.loading-progress-wrap .loading-progress .loading-progress-circle-bg { fill: none; stroke: rgb(219, 219, 219); stroke-width: 5; stroke-linecap: round; }

.loading-progress-wrap .loading-progress-percentage { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 16px; font-weight: bold; color: rgb(30, 95, 199); visibility: hidden; }

.loading-progress-wrap .loading-progress-default-text { height: 12px; font-size: 14px; color: rgba(13, 13, 13, 0.66); }

.loading-progress-wrap .loading-progress-substage { min-height: 12px; font-size: 14px; color: rgba(13, 13, 13, 0.66); display: none; position: relative; text-align: center; max-width: 80%; }

.loading-progress-wrap .loading-progress-substage .loading-progress-substage-main { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.loading-progress-wrap .loading-progress-substage .loading-progress-substage-main::after, .loading-progress-wrap .loading-progress-substage .queryinit-exec-detail::after { content: var(--ellipsis); display: inline-block; width: 0px; text-align: left; white-space: nowrap; visibility: var(--ellipsis-visible); }

.loading-progress-wrap .loading-progress-substage.has-detail .loading-progress-substage-main::after { visibility: hidden; }

.circle-transition { transition: stroke-dashoffset 0.5s linear; }

@keyframes loading-circle { 
  0% { stroke-dasharray: 0, 200px; stroke-dashoffset: 0; }
  50% { stroke-dasharray: 80px, 200px; stroke-dashoffset: -56px; }
  100% { stroke-dasharray: 0, 200px; stroke-dashoffset: -188px; }
}

.loading-progress-kill-btn { display: flex; flex-direction: column; align-items: center; margin-top: 36px; }

.loading-progress-kill-btn button { gap: 4px; padding: 2px 11px; height: 28px; border: 1px solid var(--kd-color-line-regular); border-radius: var(--kd-border-radius-middle); background: var(--kd-color-fill-base); color: var(--kd-color-text-primary); font-size: var(--kd-font-size-sub-base); line-height: 22px; cursor: pointer; transition: background 0.2s; }

.loading-progress-kill-btn button, .loading-progress-kill-btn button .kill-btn-icon { display: inline-flex; align-items: center; }

.loading-progress-kill-btn button:hover { background: var(--kd-color-fill-light); }

.loading-progress-kill-btn button:active { background: var(--kd-color-fill-regular); }

.loading-progress-kill-btn button:disabled { opacity: var(--kd-opacity-disabled,.3); cursor: not-allowed; }

.loading-progress-kill-btn button:disabled:hover { background: var(--kd-color-fill-base); }

.kill-process-confirm-dialog { position: fixed; inset: 0px; display: flex; align-items: center; justify-content: center; background: var(--kd-color-mask-regular); z-index: 9999; }

.kill-process-confirm-dialog-panel { background: var(--kd-color-background-plate); border: 1px solid var(--kd-color-line-regular); border-radius: var(--kd-border-radius-extra-large); box-shadow: var(--kd-box-shadow-large); width: 480px; padding: 10px 16px 16px; box-sizing: border-box; color: var(--kd-color-text-primary); }

.kill-process-confirm-dialog-header { display: flex; padding: 0px 12px 10px 16px; margin: 0px -16px; justify-content: space-between; align-items: center; }

.kill-process-confirm-dialog-title { font-size: var(--kd-font-size-sub-base); font-weight: 600; line-height: 24px; }

.kill-process-confirm-dialog-close { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; padding: 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: var(--kd-border-radius-small); background: transparent; cursor: pointer; transition: background 0.2s; }

.kill-process-confirm-dialog-close:hover { background: var(--kd-color-state-hover); }

.kill-process-confirm-dialog-desc { font-size: var(--kd-font-size-sub-base); font-weight: 400; line-height: 22px; white-space: pre-wrap; word-break: break-word; }

.kill-process-confirm-dialog-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; }

.kill-process-confirm-dialog-cancel, .kill-process-confirm-dialog-confirm { display: inline-flex; align-items: center; justify-content: center; height: 28px; min-width: 72px; padding: 2px 11px; border-radius: var(--kd-border-radius-middle); font-size: var(--kd-font-size-sub-base); line-height: 22px; cursor: pointer; transition: background 0.2s; }

.kill-process-confirm-dialog-confirm { background: var(--kd-color-error-normal); color: var(--kd-color-text-white,#fff); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.kill-process-confirm-dialog-confirm:hover { background: var(--kd-color-error-hover); }

.kill-process-confirm-dialog-confirm:active { background: var(--kd-color-error-pressed); }

.kill-process-confirm-dialog-confirm:disabled { opacity: var(--kd-opacity-disabled,.3); cursor: not-allowed; }

.kill-process-confirm-dialog-confirm:disabled:hover { background: var(--kd-color-error-normal); }

.kill-process-confirm-dialog-cancel { background: var(--kd-color-fill-base); color: var(--kd-color-text-primary); border: 1px solid var(--kd-color-line-regular); }

.kill-process-confirm-dialog-cancel:hover { background: var(--kd-color-fill-light); }

.kill-process-confirm-dialog-cancel:active { background: var(--kd-color-fill-regular); }

.kill-process-confirm-dialog-cancel:disabled { opacity: var(--kd-opacity-disabled,.3); cursor: not-allowed; }

.kill-process-confirm-dialog-cancel:disabled:hover { background: var(--kd-color-fill-base); }

.kill-process-confirm-dialog-close:disabled { opacity: var(--kd-opacity-disabled,.3); cursor: not-allowed; }

.kill-process-confirm-dialog-close:disabled:hover { background: transparent; }

.kill-process-cooldown-tip { color: rgb(250, 140, 22); }

.kill-process-cooldown-tip, .kill-process-error-toast { margin-top: 8px; font-size: var(--kd-font-size-small,12px); text-align: center; }

.kill-process-error-toast { color: var(--kd-color-error-normal,#dd3332); }

.embed-container-blur .et-grid-modal-popup { visibility: hidden; }

.embed-container-blur .et-cell-upload-progress { visibility: visible !important; }

.embed-container .loading-page, .embed-container .loading-page-custom, .embed-container .loading-progress-wrap { display: none !important; }

.embed-container .editor-mask { height: auto !important; }

.embed-container .component-error-page { position: relative; }

.embed-container .container-wrap.otl-hide-history-right-panel .task-pane-wrap { display: none; }

.embed-container .kd-popup { position: fixed !important; }

