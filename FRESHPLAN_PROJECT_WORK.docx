.component-bottom-dialog .bottom-dialog-body { position: absolute; left: 0px; right: 0px; bottom: 0px; box-shadow: rgba(56, 58, 68, 0.05) 0px -2px 3px 0px; background: rgb(255, 255, 255); border-radius: 8px 8px 0px 0px; overflow: hidden; display: flex; flex-direction: column; }

