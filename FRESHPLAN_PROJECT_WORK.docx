.kd-checkbox-input.is-checked .kd-checkbox-inner::after { transform: rotate(45deg) scaleY(1); }

.kd-checkbox-input.is-checked .kd-checkbox-inner:hover { background-color: var(--kd-color-public-hover); }

.kd-checkbox-input.is-focus .kd-checkbox-inner { border-color: var(--kd-color-public-hover); }

