.wps-context-menu.component-context-menu .first-row { height: 60px; }

.wps-context-menu.component-context-menu .first-row .context-menu-item { height: 100%; }

.wps-context-menu.component-context-menu .first-row .context-menu-item .menu-content { padding: 3px 0px 0px; }

