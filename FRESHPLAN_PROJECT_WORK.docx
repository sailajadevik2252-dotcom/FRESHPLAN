.component-toast { top: 0px; left: 0px; width: 100%; text-align: center; z-index: 1040; }

.component-toast, .component-toast.in-container { position: absolute; }

.component-toast .toast-body { position: relative; display: inline-flex; font-size: 12px; white-space: pre-wrap; color: rgb(255, 255, 255); max-width: calc(100% - 32px); overflow: hidden; padding: 8px 16px; border-radius: 4px; background: rgba(37, 37, 37, 0.9); align-items: flex-start; justify-content: space-between; }

.component-toast .toast-body.toast-in { animation: 0.2s ease 0s 1 normal none running toast-in; }

.component-toast .toast-body.toast-out { animation: 0.2s ease 0s 1 normal none running toast-out; }

.component-toast .toast-body .toast-kd-icon { margin-right: 12px; }

.component-toast .toast-body .toast-kd-icon.toast-kd-icon-loading-white { animation: 0.8s linear 0s infinite normal none running spinning; margin-top: 0px; }

.component-toast .toast-body .toast-button { color: rgb(67, 140, 250); margin-left: 16px; display: inline-block; text-align: start; max-width: 40%; }

.component-toast .toast-body .toast-adjust-test { margin-right: 16px; text-align: start; flex: 1 1 0%; }

.component-toast .toast-swipeable { touch-action: pan-y; cursor: grab; position: relative; }

.component-toast .toast-swipeable:active { cursor: grabbing; }

.component-toast .toast-swipeable[style*="translateY"] { box-shadow: 0 4px 20px rgba(var(--kd-color-black),.15); }

.component-toast .new-toast-body { position: relative; display: inline-flex; font-size: 14px; white-space: pre-wrap; color: rgb(255, 255, 255); max-width: calc(100% - 32px); overflow: hidden; padding: 14px 16px; border-radius: 12px; background: rgba(37, 37, 37, 0.9); justify-content: space-between; min-height: 50px; }

.component-toast .new-toast-body.toast-in { animation: 0.2s ease 0s 1 normal none running toast-in; }

.component-toast .new-toast-body.toast-out { animation: 0.2s ease 0s 1 normal none running toast-out; }

.component-toast .new-toast-body .toast-kd-icon { margin-right: 8px; }

.component-toast .new-toast-body .toast-kd-icon.toast-kd-icon-loading-white { margin-top: -4px; animation: 0.8s linear 0s infinite normal none running spinning; }

.component-toast .new-toast-body .toast-button { color: var(--blue-kd-color-blue-4,#74a9fd); margin-left: 16px; display: inline-block; text-align: start; max-width: 40%; font-weight: 600; }

.component-toast .new-toast-body .toast-adjust-text { margin-right: 16px; text-align: start; flex: 1 1 0%; min-width: 50%; }

.component-toast .new-toast-body .toast-close { margin-left: 16px; }

.component-toast .new-toast-full-width { width: 100%; }

@keyframes toast-in { 
  0% { opacity: 0; transform: translate3d(0px, -50%, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@keyframes toast-out { 
  0% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(0px, -5px, 0px); }
}

.mobile-kd-icon.kd-icon { font-size: 24px; }

.component-notice { position: absolute; top: 0px; left: 0px; width: 100%; height: 0px; text-align: center; z-index: 1040; }

.component-notice .notice-body { position: relative; display: inline-flex; align-items: center; background: rgb(255, 255, 255); max-width: 90%; border-radius: 4px; padding: 8px 8px 8px 16px; font-size: 12px; box-shadow: rgba(9, 23, 49, 0.21) 0px 2px 6px 0px; overflow: hidden; animation: 0.2s ease 0s 1 normal none running notice-show; }

.component-notice .notice-body .notice-content { flex-grow: 1; display: inline-flex; align-items: center; }

.component-notice .notice-body .notice-close-btn { display: inline-flex; align-items: center; justify-content: center; margin-left: 16px; border-radius: 2px; }

.component-notice .notice-body .notice-close-btn:active { background: rgb(233, 236, 240); }

.component-notice .notice-body-new { box-sizing: border-box; position: relative; width: 90%; background: var(---kd-color-info-light,#edf4ff); padding: 12px 16px 11px; animation: 0.2s ease 0s 1 normal none running notice-show; display: inline-flex; align-items: flex-start; box-shadow: rgba(9, 23, 49, 0.21) 0px 2px 6px 0px; border-radius: 8px; }

.component-notice .notice-body-new-icon { margin-right: 12px; width: 22px; height: 22px; }

.component-notice .notice-body-new-content { flex-grow: 1; text-align: justify; line-height: 22px; }

.component-notice .notice-body-new-close-btn { margin-left: 16px; margin-right: 3px; position: relative; top: -3px; }

@keyframes notice-show { 
  0% { opacity: 0; transform: translate3d(0px, -50%, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

.component-fullscreen-panel { position: absolute; inset: 0.1px 0px 0px; z-index: 1000; }

.component-fullscreen-panel .panel-mask { position: absolute; inset: 0px; background: rgb(0, 0, 0); opacity: 0; }

.component-fullscreen-panel .panel-body { position: absolute; inset: 0px; background: rgb(255, 255, 255); display: flex; flex-direction: column; }

.component-fullscreen-panel .panel-body::before { content: ""; position: absolute; top: 0px; bottom: 0px; width: 1px; background: rgb(217, 217, 217); transform: scaleX(0.5); transform-origin: left top; left: -0.5px; }

.component-fullscreen-panel .panel-header { flex-shrink: 0; position: relative; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; }

.component-fullscreen-panel .panel-header::after { content: ""; position: absolute; left: 0px; right: 0px; bottom: 0px; height: 1px; background: rgb(217, 217, 217); transform: scaleY(0.5); transform-origin: left bottom; }

.component-fullscreen-panel .panel-content { flex-grow: 1; overflow: auto; height: 100%; }

.component-fullscreen-panel.in-bottom-tab { top: auto; height: 259.9px; }

.component-fullscreen-panel.in-bottom-tab .component-panel-header::after { display: none; }

.component-fullscreen-panel.new-layout-need-safe-bottom:not(.in-bottom-tab) .panel-body { padding-bottom: var(--safe-bottom); bottom: 0px !important; }

.component-fullscreen-panel.new-layout-need-safe-bottom.in-bottom-tab .panel-content { padding-bottom: var(--safe-bottom); }

.component-icon-btn { position: relative; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; padding: 6px; border-radius: 4px; }

.component-icon-btn:not(.disabled).active, .component-icon-btn:not(.disabled).selected, .component-icon-btn:not(.disabled):active { background: rgb(233, 236, 240); }

.component-icon-btn .icons-comp { display: flex; align-items: center; justify-content: center; width: 20px; height: 20px; margin-bottom: 2px; }

.component-icon-btn.btn-theme-k.selected { background: var(--kd-color-state-pressed-brand); }

.component-icon-btn.btn-theme-k.selected .icons { filter: var(--kd-color-state-pressed-brand-filter); }

.component-icon-btn.btn-theme-k.activated { background: var(--kd-color-state-pressed-brand); }

.component-icon-btn.btn-theme-k.activated .icons { filter: var(--kd-color-state-pressed-brand-filter); }

.component-icon-btn.btn-theme-s.selected { background: var(--kd-color-state-pressed-brand); }

.component-icon-btn.btn-theme-s.selected .icons { filter: var(--kd-color-state-pressed-brand-filter); }

.component-icon-btn.btn-theme-s.activated { background: var(--kd-color-state-pressed-brand); }

.component-icon-btn.btn-theme-s.activated .icons { filter: var(--kd-color-state-pressed-brand-filter); }

.component-text-btn { position: relative; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; padding: 7px 16px; opacity: 0.999; }

.component-text-btn .btn-text { display: inline-flex; justify-content: space-between; align-items: center; }

.component-text-btn.active, .component-text-btn.selected, .component-text-btn:active { opacity: 0.4; }

.component-text-btn.disabled { opacity: 0.2; }

.component-text-btn.btn-theme-d, .component-text-btn.btn-theme-k, .component-text-btn.btn-theme-s { color: var(--kd-color-brand-normal); }

.component-text-btn.btn-theme-o, .component-text-btn.btn-theme-w { color: rgb(73, 145, 242); }

.component-text-btn.btn-theme-p { color: rgb(244, 109, 67); }

.component-text-btn.btn-theme-f { color: rgb(235, 84, 81); }

.component-text-btn.btn-theme-unknown { color: rgb(65, 127, 249); }

.component-icon-text-btn { position: relative; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; padding: 6px; border-radius: 4px; }

.component-icon-text-btn:not(.disabled).active, .component-icon-text-btn:not(.disabled).selected, .component-icon-text-btn:not(.disabled):active { background: rgb(233, 236, 240); }

.component-icon-text-btn .btn-icon { margin-right: 8px; }

.component-icon-text-btn .icons-comp { display: flex; align-items: center; justify-content: center; }

.component-icon-text-btn .btn-text { display: inline-flex; justify-content: space-between; align-items: center; }

.component-block-btn { position: relative; flex-shrink: 0; align-items: center; justify-content: center; display: flex; padding: 10px; border-radius: 4px; font-size: 16px; border: 1px solid rgb(217, 217, 217); background: rgb(245, 247, 251); }

.component-block-btn:not(.disabled).active, .component-block-btn:not(.disabled).selected, .component-block-btn:not(.disabled):active { background: rgb(233, 236, 240); }

.component-block-btn .btn-icon { margin-right: 12px; }

.component-block-btn .icons-comp { display: flex; align-items: center; justify-content: center; }

.component-block-btn .btn-text { display: inline-flex; justify-content: space-between; align-items: center; }

.component-block-btn.btn-theme-s { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(255, 255, 255); background: var(--kd-color-brand-normal); }

.component-block-btn.btn-theme-s.active, .component-block-btn.btn-theme-s:active { background: var(--kd-color-brand-pressed); }

.component-block-btn.btn-theme-s.selected { background: var(--kd-color-state-pressed-brand); }

.component-block-btn.btn-theme-k { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(255, 255, 255); background: var(--kd-color-brand-normal); }

.component-block-btn.btn-theme-k.active, .component-block-btn.btn-theme-k:active { background: var(--kd-color-brand-pressed); }

.component-block-btn.btn-theme-k.selected { background: var(--kd-color-state-pressed-brand); }

.component-block-btn.btn-theme-d { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(255, 255, 255); background: var(--kd-color-brand-normal); }

.component-block-btn.btn-theme-d.active, .component-block-btn.btn-theme-d.selected, .component-block-btn.btn-theme-d:active { background: var(--kd-color-brand-pressed); }

.component-block-btn.btn-theme-w { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(255, 255, 255); background: rgb(73, 145, 242); }

.component-block-btn.btn-theme-w.active, .component-block-btn.btn-theme-w.selected, .component-block-btn.btn-theme-w:active { background: rgb(65, 130, 217); }

.component-block-btn.btn-theme-p { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(255, 255, 255); background: rgb(244, 109, 67); }

.component-block-btn.btn-theme-p.active, .component-block-btn.btn-theme-p.selected, .component-block-btn.btn-theme-p:active { background: rgb(219, 97, 60); }

.component-block-btn.btn-theme-f { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(255, 255, 255); background: rgb(235, 84, 81); }

.component-block-btn.btn-theme-f.active, .component-block-btn.btn-theme-f.selected, .component-block-btn.btn-theme-f:active { background: rgb(211, 75, 72); }

.component-block-btn.btn-theme-o { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(255, 255, 255); background: rgb(118, 99, 221); }

.component-block-btn.btn-theme-o.active, .component-block-btn.btn-theme-o.selected, .component-block-btn.btn-theme-o:active { background: rgb(118, 99, 221); }

.component-block-btn.btn-theme-unknown { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(255, 255, 255); background: rgb(65, 127, 249); }

.component-block-btn.btn-theme-unknown.active, .component-block-btn.btn-theme-unknown.selected, .component-block-btn.btn-theme-unknown:active { background: rgb(58, 114, 223); }

.icons { display: inline-block; vertical-align: top; background-repeat: no-repeat; background-size: 100% 100%; flex-shrink: 0; }

.icons.icons-18 { width: 18px; height: 18px; }

.icons.icons-24 { width: 24px; height: 24px; }

.icons.icons-36 { width: 36px; height: 36px; }

.icons .icons-loading { display: inline-block; width: 100%; height: 100%; border-radius: 50%; border-width: 4px; border-style: solid; border-right-color: rgb(65, 127, 249); border-bottom-color: rgb(65, 127, 249); border-left-color: rgb(65, 127, 249); border-image: none; box-sizing: border-box; animation: 1.2s linear 0s infinite normal none running icons-loading; will-change: transform; border-top-color: transparent !important; }

.icons.icons-18 .icons-loading, .icons.icons-24 .icons-loading { border-width: 2px; }

@keyframes icons-loading { 
  0% { transform: rotate(-1turn); }
  100% { transform: rotate(0deg); }
}

.theme-d .icons .icons-loading, .theme-k .icons .icons-loading, .theme-s .icons .icons-loading { border-color: var(--kd-color-brand-normal); }

.theme-w .icons .icons-loading { border-color: rgb(73, 145, 242); }

.theme-p .icons .icons-loading { border-color: rgb(244, 109, 67); }

.theme-b .icons .icons-loading { border-color: rgb(98, 107, 132); }

.theme-o .icons .icons-loading { border-color: rgb(118, 99, 221); }

.theme-f .icons .icons-loading { border-color: rgb(235, 84, 81); }

.component-panel-title { position: relative; font-size: 13px; color: rgba(0, 0, 0, 0.4); padding: 9px 16px; }

.component-panel-item { position: relative; display: flex; align-items: center; }

.component-panel-item:not(.no-active):active { background: rgb(233, 236, 240); }

.component-panel-item.show-border::after { content: ""; position: absolute; right: 0px; bottom: 0px; height: 1px; background: rgb(217, 217, 217); transform: scaleY(0.5); transform-origin: left bottom; left: 56px; }

.component-panel-item.no-icon .panel-item-content { padding-left: 16px; }

.component-panel-item.no-icon::after { left: 16px; }

.component-panel-item .panel-item-icon { flex-shrink: 0; display: inline-flex; margin: 0px 16px; }

.component-panel-item .panel-item-content { flex-grow: 1; display: inline-flex; align-items: center; padding-right: 16px; min-height: 56px; overflow: hidden; }

.component-panel-item .panel-item-text { flex-grow: 1; display: inline-flex; align-items: center; justify-content: space-between; overflow: hidden; }

.component-panel-item .panel-item-suffix { flex-shrink: 0; margin-left: 6px; min-width: 24px; }

.component-panel-item .panel-item-swiper { position: absolute; left: 100%; display: inline-flex; }

.component-panel-item.disabled .kd-icon svg { opacity: 0.3 !important; }

[dir="rtl"] .component-panel-item .icons-24-arrow_right_gray { transform: rotateY(180deg); }

.component-panel-header { flex-shrink: 0; position: relative; display: flex; align-items: center; justify-content: center; padding: 0px 16px; min-height: 50px; transform: translateZ(999px); }

.component-panel-header::after { content: ""; position: absolute; left: 0px; right: 0px; bottom: 0px; height: 1px; background: rgb(217, 217, 217); transform: scaleY(0.5); transform-origin: left bottom; }

.component-panel-header .component-text-btn { padding-left: 0px; padding-right: 0px; font-weight: bold; font-size: 16px; }

.component-panel-header .header-item { flex-shrink: 0; font-weight: bold; }

.component-panel-header .header-item.header-title { flex-shrink: 1; flex-grow: 1; text-align: center; font-size: 17px; padding: 0px 16px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; overflow-wrap: normal; }

.component-half-screen-panel { position: absolute; bottom: 0px; left: 0px; right: 0px; z-index: 1000; }

.component-half-screen-panel.show-mask { top: 0px; }

.component-half-screen-panel.show-mask.mask-transparency .panel-mask { opacity: 0 !important; }

.component-half-screen-panel.show-mask .panel-mask { position: absolute; inset: 0px; background: rgb(0, 0, 0); opacity: 0; will-change: opacity; }

.component-half-screen-panel.show-header .panel-body { padding-top: 12px; }

.component-half-screen-panel .panel-body { position: fixed; left: 0px; right: 0px; bottom: 0px; padding-bottom: env(safe-area-inset-bottom,0); height: 0px; background: rgb(255, 255, 255); box-shadow: rgba(56, 58, 68, 0.05) 0px -2px 3px 0px; border-top: 0.5px solid rgb(217, 217, 217); border-radius: 8px 8px 0px 0px; padding-top: 16px; display: flex; flex-direction: column; overflow: hidden; will-change: height; }

