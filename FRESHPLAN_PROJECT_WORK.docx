@charset "utf-8";

.webshape-wrapper-scale { transform-origin: left top; pointer-events: auto; border: 1px solid var(--kd-color-line-regular); border-radius: 8px; overflow: hidden; }

.webshape-wrapper-scale .webshape-click-mask { position: absolute; inset: 0px; display: none; cursor: move; }

.webshape-wrapper-scale .webshape-click-mask.showMask { display: block; }

.webshape-wrapper-scale .webshape-top-bar { position: absolute; left: 0px; right: 0px; top: 0px; height: 44px; display: flex; flex-direction: row; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--kd-color-line-regular); overflow: hidden; cursor: auto; background-color: rgb(255, 255, 255); }

.webshape-wrapper-scale .webshape-top-bar .webshape-top-bar-left-part { height: 44px; width: fit-content; display: flex; flex-direction: row; align-items: center; padding: 0px; margin-left: 12px; min-width: 20px; }

.webshape-wrapper-scale .webshape-top-bar .webshape-top-bar-left-part i { height: 16px; width: 16px; background-size: contain; margin-right: 4px; }

.webshape-wrapper-scale .webshape-top-bar .webshape-top-bar-left-part span { height: 44px; font-style: normal; font-family: "PingFang SC"; font-weight: 400; font-size: 14px; line-height: 44px; color: var(--kd-color-text-primary); text-transform: capitalize; display: flex; align-items: center; white-space: nowrap; max-width: calc(100% - 128px); }

.webshape-wrapper-scale .webshape-top-bar .webshape-top-bar-right-part { height: 28px; width: fit-content; display: flex; flex-direction: row; align-items: center; border-radius: 6px; cursor: pointer; background-color: rgb(255, 255, 255); padding-right: 12px; padding-left: 24px; }

.webshape-wrapper-scale .webshape-top-bar .webshape-top-bar-right-part span { font-family: "PingFang SC"; font-style: normal; font-weight: 400; font-size: 14px; line-height: 22px; color: rgb(10, 108, 255); cursor: pointer; min-width: 56px; }

.webshape-wrapper-scale .webshape-frame-page-info-box { position: absolute; inset: 44px 0px 0px; overflow: hidden; display: flex; flex-direction: column; justify-content: center; align-items: center; background-color: rgb(250, 250, 250); padding: 10px; }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-loading-content { display: flex; flex-direction: row; align-items: center; justify-content: center; padding: 0px; height: 22px; }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-loading-content img { width: 16px; height: 16px; margin-right: 4px; }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-loading-content span { font-size: 14px; font-weight: 400; height: 22px; line-height: 22px; align-items: center; color: var(--kd-color-text-primary); }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-no-nest-content { font-size: 16px; }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-authrization-page { display: flex; flex-direction: column; justify-content: center; align-items: center; }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-authrization-page .webshape-authrization-content { height: 24px; font-family: "PingFang SC"; font-style: normal; font-weight: 600; font-size: 16px; line-height: 24px; color: var(--kd-color-text-primary); }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-authrization-page .webshape-authrization-info { font-family: "PingFang SC"; font-style: normal; font-weight: 400; font-size: 14px; line-height: 22px; text-align: center; margin: 8px 0px; color: var(--kd-color-text-secondary); }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-authrization-page .webshape-authrization-buttons { width: 154px; display: flex; flex-direction: row; align-items: center; height: 32px; }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-authrization-page .webshape-authrization-buttons .webshape-authrization-cancel-button { width: 123.5px; height: 32px; background-color: rgb(245, 247, 250); border-radius: 4px; padding: 4px 15px; line-height: 22px; text-align: center; font-weight: 400; font-size: 14px; color: var(--kd-color-text-primary); cursor: pointer; margin-right: 8px; box-shadow: 0 0 0 1px var(--kd-color-state-pressed),0 1px 0 hsla(0,0%,5%,.14); }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-authrization-page .webshape-authrization-buttons .webshape-authrization-confirm-button { width: 123.5px; height: 32px; background-color: rgb(10, 108, 255); border-radius: 4px; padding: 4px 15px; line-height: 22px; text-align: center; font-weight: 400; font-size: 14px; color: rgb(255, 255, 255); cursor: pointer; }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-error-box { display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 0px; width: fit-content; height: fit-content; margin-bottom: 16px; }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-error-box div { height: 100px; width: 100px; }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-error-box .normal-err-text { color: var(--kd-color-text-primary,hsla(0,0%,5%,.9)); font-family: "PingFang SC"; font-size: 14px; font-style: normal; font-weight: 400; line-height: 22px; margin-top: 16px; }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-error-box .bold-err-text { font-family: "PingFang SC"; font-style: normal; font-weight: 600; font-size: 16px; line-height: 24px; display: flex; align-items: center; color: var(--kd-color-text-primary); }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-error-box .reject-text { color: var(--kd-color-text-tertiary,hsla(0,0%,5%,.46)); font-family: "PingFang SC"; font-size: 14px; font-style: normal; font-weight: 400; line-height: 22px; }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-error-box .webshape-reload-page { font-family: "PingFang SC"; font-style: normal; font-weight: 400; font-size: 14px; line-height: 22px; padding: 3px 8px; height: 28px; width: 80px; cursor: pointer; text-align: center; border-radius: 4px; background-color: var(--kd-color-state-normal); color: rgb(10, 108, 255); }

.webshape-wrapper-scale .webshape-frame-page-info-box .webshape-error-box .webshape-reload-page.isMobileOrPad { background-color: rgb(10, 108, 255); color: rgb(255, 255, 255); }

.webshape-wrapper-scale .webshape-iframe-wrapper { position: absolute; inset: 44px 0px 0px; }

.webshape-wrapper-scale .webshape-iframe-wrapper iframe { height: 100%; width: 100%; }

.component-icon-btn { position: relative; display: inline-block; padding: 4px; border-radius: 2px; white-space: nowrap; flex-shrink: 0; }

.component-icon-btn.dropdown { padding-right: 14px; }

.component-icon-btn.disabled { pointer-events: inherit; }

.component-icon-btn:not(.disabled):hover { background: var(--kd-color-state-hover); }

.component-icon-btn.selected, .component-icon-btn:not(.disabled):active { background: var(--kd-color-state-pressed); }

.component-icon-btn.show-border { border: 1px solid var(--kd-color-line-regular); background: var(--kd-color-background-bottom); padding-top: 1px; padding-bottom: 1px; }

.component-icon-btn.show-border.dropdown::after { right: 4px; }

.wowui-tooltip { position: fixed; top: 0px; left: 0px; right: 10px; z-index: 1040; }

.wowui-tooltip-content { position: absolute; }

.wowui-tooltip-content.not-lottie { background: var(--kd-color-background-top); box-shadow: rgba(56, 56, 56, 0.2) 0px 2px 12px 0px; border-radius: 4px; color: var(--kd-color-text-secondary); max-width: 80%; padding: 8px 12px; line-height: 1.5; transform-origin: center top; animation: 0.1s ease 0s 1 normal none running wowui-toast-animation; }

.wowui-tooltip-content .tooltip-text { white-space: pre; }

.wowui-tooltip-content .tooltip-auto-wrap { max-width: 326px; white-space: pre-wrap; word-break: normal; }

@keyframes wowui-toast-animation { 
  0% { opacity: 0; transform: scale(0.8); }
  100% { opacity: 1; transform: scale(1); }
}

.content-vertical-align { display: flex; align-items: center; }

.scrollbar-hover-show::-webkit-scrollbar-thumb { display: none; }

.scrollbar-hover-show:hover::-webkit-scrollbar-thumb { display: initial; }

.wowui-lottie { display: inline-block; box-sizing: content-box; overflow: hidden; box-shadow: var(--kd-box-shadow-large); border: 1px solid var(--kd-color-line-regular); border-radius: var(--kd-border-radius-large); }

.icons { vertical-align: middle; display: inline-block; background-repeat: no-repeat; background-size: 100% 100%; flex-shrink: 0; }

.icons.icons-16 { width: 16px; height: 16px; }

.icons.icons-24 { width: 24px; height: 24px; }

.icons.icons-30 { width: 30px; height: 30px; }

.icons.icons-38 { width: 38px; height: 38px; }

.icons.icons-48 { width: 48px; height: 48px; }

.icons.icons-64 { width: 64px; height: 64px; }

.icons.icons-loading { position: relative; }

.icons.icons-loading::after, .icons.icons-loading::before { content: ""; position: absolute; inset: 0px; border-radius: 50%; border: 2px solid transparent; }

.icons.icons-loading::before { border-color: var(--kd-color-line-regular); }

.icons.icons-loading::after { animation: 1s linear 0s infinite normal none running icons-loading; border-top-color: rgb(65, 127, 249); }

@keyframes icons-loading { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

.theme-k .icons.icons-loading::after, .theme-s .icons.icons-loading::after { border-top-color: var(--kd-color-brand-normal); }

.theme-d .icons.icons-loading::after { border-top-color: var(--db-color-normal,#0bb); }

.theme-w .icons.icons-loading::after { border-top-color: rgb(73, 145, 242); }

.theme-p .icons.icons-loading::after { border-top-color: rgb(244, 109, 67); }

.theme-f .icons.icons-loading::after { border-top-color: var(--kd-color-brand-normal,#eb5451); }

.theme-b .icons.icons-loading::after { border-top-color: rgb(98, 107, 132); }

.theme-o .icons.icons-loading::after { border-top-color: rgb(118, 99, 221); }

.kd-tooltip { z-index: var(--kd-z-index-tip); background: var(--kd-color-background-top); border: 1px solid var(--kd-color-line-regular); border-radius: var(--kd-border-radius-middle); box-shadow: var(--kd-box-shadow-large); }

.kd-tooltip, .kd-tooltip-content { color: var(--kd-color-text-primary); }

.kd-tooltip-content { padding: 6px 12px; font-size: var(--kd-font-size-sub-base); line-height: 20px; word-break: normal; overflow-wrap: break-word; white-space: normal; box-sizing: border-box; }

.kd-tooltip-content .kd-tooltip-text { white-space: pre; }

.kd-tooltip-content .kd-tooltip-auto-wrap { word-break: normal; white-space: pre-wrap; }

.kd-tooltip-arrow { background: var(--kd-color-background-top); border-color: var(--kd-color-line-regular); }

.kd-popover { z-index: var(--kd-z-index-popover); background: var(--kd-color-background-top); border: 1px solid var(--kd-color-line-regular); box-shadow: var(--kd-box-shadow-large); border-radius: var(--kd-border-radius-middle); }

.kd-popover-content { padding: 8px; font-size: var(--kd-font-size-sub-base); line-height: 22px; color: var(--kd-color-text-primary); word-break: break-all; overflow-wrap: break-word; white-space: normal; box-sizing: border-box; }

.kd-popover-content .kd-popover-text { white-space: pre; }

.kd-popover-content .kd-popover-auto-wrap { word-break: normal; white-space: pre-wrap; }

.kd-popover-arrow { background: var(--kd-color-background-top); border-color: var(--kd-color-line-regular); }

@keyframes kd-popover-animation { 
  0% { opacity: 0; transform: scale(0.8); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes kd-popper-animation { 
  0% { opacity: 0; transform: scale(0.5); }
  100% { opacity: 1; transform: scale(1); }
}

.kd-popper-fade-appear-active, .kd-popper-fade-exit { animation: 0.1s ease 0s 1 normal none running kd-popper-animation; }

.kd-popup-arrow { position: absolute; width: 11px; height: 11px; border-top-right-radius: 4px; border-style: solid; border-width: 1px 1px 0px 0px; }

[dir="rtl"] .kd-popup-arrow { border-top-right-radius: 0px; border-top-left-radius: 4px; border-width: 1px 0px 0px 1px; }

[x-placement^="bottom"] .kd-popup-arrow { top: -6.5px; transform: rotate(-45deg); }

[dir="rtl"] [x-placement^="bottom"] .kd-popup-arrow { transform: rotate(45deg); }

[x-placement^="top"] .kd-popup-arrow { bottom: -6.5px; transform: rotate(135deg); }

[dir="rtl"] [x-placement^="top"] .kd-popup-arrow { transform: rotate(-135deg); }

[x-placement^="left"] .kd-popup-arrow { right: -6.5px; transform: rotate(45deg); }

[dir="rtl"] [x-placement^="left"] .kd-popup-arrow { transform: rotate(135deg); }

[x-placement^="right"] .kd-popup-arrow { left: -6.5px; transform: rotate(-135deg); }

[dir="rtl"] [x-placement^="right"] .kd-popup-arrow { transform: rotate(-45deg); }
