.shape-video-player .video-control .bottom .panel .panel-left > div { margin-right: 10px; }

.shape-video-player .video-control .bottom .panel .panel-left > div:last-child { margin-right: 0px; }

.shape-video-player .video-control .bottom .panel .panel-left .time { color: rgb(255, 255, 255); user-select: none; font-weight: 350; }

.shape-video-player .video-control .bottom .panel .panel-left .play-btn { cursor: pointer; }

.shape-video-player .video-control .bottom .panel .panel-left .volume-btn { position: relative; }

.shape-video-player .video-control .bottom .panel .panel-left .volume-btn::before { background: rgb(255, 255, 255); opacity: 0; content: ""; display: block; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); height: 130%; width: 150%; pointer-events: none; border-radius: 3px; z-index: -1; }

.shape-video-player .video-control .bottom .panel .panel-left .volume-btn.active::before { opacity: 1 !important; }

