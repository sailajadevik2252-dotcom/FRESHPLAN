.kd-component-confirm .confirm-footer.space-average { display: flex; flex-flow: row-reverse wrap; gap: 12px; }

.kd-component-confirm .confirm-footer.space-average .kd-component-text-btn { flex: 1 1 auto; min-width: calc(50% - 6px); max-width: 100%; width: auto; white-space: nowrap; }
