.component-recorder-panel .recorder-panel-content .recorder-btn.recording-theme-w { background: rgb(65, 130, 217); }

.component-recorder-panel .recorder-panel-content .recorder-btn.recording-theme-p { background: rgb(219, 97, 60); }

