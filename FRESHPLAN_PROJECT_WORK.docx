.component-switch { flex-shrink: 0; cursor: pointer; display: inline-block; position: relative; height: 30px; width: 50px; border-radius: 15px; background: rgb(233, 233, 234); overflow: hidden; }

.component-switch::before { content: ""; position: absolute; inset: 0px; border-radius: 15px; transition: opacity 0.2s; opacity: 0; background: rgb(65, 127, 249); }

.component-switch::after { content: ""; position: absolute; left: 2px; top: 2px; height: 26px; width: 26px; border-radius: 13px; background: rgb(255, 255, 255); transition: left 0.2s, width 0.2s; }

.component-switch:active::after { width: 31px; }

.component-switch.checked::before { opacity: 1; }

.component-switch.checked::after { left: 22px; }

.component-switch.checked:active::after { left: 17px; }

.component-switch.small { height: 24px; width: 40px; border-radius: 12px; background: rgb(233, 233, 233); }

.component-switch.small::before { border-radius: 12px; }

.component-switch.small::after { left: 2px; top: 2px; height: 20px; width: 20px; border-radius: 10px; }

.component-switch.small:active::after { width: 25px; }

.component-switch.small.checked::after { left: 18px; }

.component-switch.small.checked:active::after { left: 13px; }

.theme-d .component-switch::before, .theme-k .component-switch::before, .theme-s .component-switch::before { background: var(--kd-color-public-normal); }

