.kd-checkbox-input.is-indeterminate .kd-checkbox-inner::before { position: absolute; top: 50%; right: 3px; left: 3px; display: block; margin-top: -1px; content: ""; border-top: 2px solid var(--kd-color-icon-white); }

.kd-checkbox-input.is-indeterminate .kd-checkbox-inner::after { display: none; }

.kd-checkbox-inner { position: relative; display: inline-block; width: 14px; height: 14px; background-color: var(--kd-color-fill-base); border-radius: var(--kd-border-radius-extra-small); border: 1px solid var(--kd-color-line-heavy); box-sizing: border-box; transition: border-color 0.25s cubic-bezier(0.71, -0.46, 0.29, 1.46), background-color 0.25s cubic-bezier(0.71, -0.46, 0.29, 1.46); }

.kd-checkbox-inner:hover { background-color: var(--kd-color-state-hover); }

.kd-checkbox-inner::after { position: absolute; top: 1px; left: 4px; width: 3px; height: 6px; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; content: ""; transform: rotate(45deg) scaleY(0); box-sizing: content-box; border-left: 0px; border-top: 0px; transition: transform 0.15s cubic-bezier(0.71, -0.46, 0.88, 0.6) 0.05s; transform-origin: center center; }

.kd-checkbox-original { position: absolute; left: -9999px; margin: 0px; outline: none; opacity: 0; visibility: hidden; size: 0px; }

[dir="rtl"] .kd-checkbox-original { left: auto; right: -9999px; }

