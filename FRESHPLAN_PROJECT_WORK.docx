.resizing foreignobject::after { content: ""; display: block; position: absolute; inset: 0px; background-color: transparent; z-index: 99; }

.player-progress { position: relative; width: 100%; box-sizing: border-box; user-select: none; display: flex; justify-content: center; height: 20px; align-items: center; }

