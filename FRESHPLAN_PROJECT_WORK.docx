Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://global-static.wpscdn.com/docs/weboffice-static/js/chunk/index-mobile.b19ad2f8.en-US.css

@charset "utf-8";

body { position: absolute; height: auto; top: 0px; left: 0px; right: 0px; bottom: var(--safe-bottom); font-size: 16px; text-size-adjust: none; touch-action: manipulation; color: rgb(0, 0, 0); line-height: 1.5; }

* { box-sizing: border-box; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); }

:focus { outline: none; }

* textarea { resize: none; }

#root { width: 100%; height: 100%; display: flex; flex-direction: column; visibility: visible !important; }

::selection { background: rgb(72, 123, 251); color: rgb(255, 255, 255); }

::-webkit-input-placeholder { color: rgb(175, 175, 175); }

button, input, optgroup, select, textarea { margin: 0px; font-family: inherit; font-size: inherit; line-height: inherit; color: inherit; }

article, aside, blockquote, button, code, dd, details, div, dl, dt, fieldset, figcaption, figure, footer, form, h1, h2, h3, h4, h5, h6, header, hgroup, hr, input, legend, li, menu, nav, ol, p, pre, section, td, textarea, th, ul { margin: 0px; padding: 0px; }

input[type="password"], input[type="text"], textarea { border-radius: 0px; }

input[type="password"]:active, input[type="password"]:focus, input[type="text"]:active, input[type="text"]:focus, textarea:active, textarea:focus { border-color: rgb(204, 204, 204); }

textarea { display: block; resize: none; outline: none; }

iframe { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

p { margin-top: 0px; margin-bottom: 0px; }

a { cursor: pointer; text-decoration: none; }

i { font-style: normal; }

.animation-fade-in-up { animation: 0.2s ease 0s 1 normal none running fadeInUp; }

.animation-fade-out-down { animation: 0.2s ease 0s 1 normal none running fadeOutDown; }

.animation-fade-out-up { animation: 0.2s ease 0s 1 normal none running fadeOutUp; }

@keyframes fadeInUp { 
  0% { opacity: 0; transform: translate3d(0px, 100%, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@keyframes fadeOutDown { 
  0% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(0px, 100%, 0px); }
}

@keyframes fadeOutUp { 
  0% { opacity: 1; }
  100% { opacity: 0; transform: translate3d(0px, -5px, 0px); }
}

.dropdown { position: relative; }

.dropdown::after { position: absolute; top: calc(50% - 1.5px); content: ""; width: 0px; height: 0px; right: 2px; border-color: rgb(162, 162, 162) transparent transparent; border-style: solid solid none; border-width: 3px 3px 0px; transition: transform 0.3s; }

.ul-dot > li { list-style: none; }

.ul-dot > li::before { content: ""; display: inline-block; margin-right: 10px; vertical-align: middle; background: rgb(0, 0, 0); height: 4px; width: 4px; border-radius: 50%; }

.hide-header .component-header { display: none !important; }

.blocking-mask { cursor: wait; position: absolute; inset: 0px; z-index: 9999; }

.disabled { pointer-events: none; opacity: 0.2; }

.disabled * { opacity: 1 !important; }

.file-opening { pointer-events: none; }

.file-opening .disabled { opacity: 1 !important; }

.hidden { display: none !important; }

.transform180 { transform: rotate(180deg); }

.sub-title { color: rgba(0, 0, 0, 0.7); }

.sub-title, .three-title { font-size: 13px; line-height: 22px; }

.three-title { color: rgba(0, 0, 0, 0.4); }

