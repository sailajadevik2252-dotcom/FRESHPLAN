  .platform-box_wrap .platform-body .body-top.body-brand.body-brand-11, .platform-box_wrap .platform-body .body-top.body-brand.body-brand-12 { top: calc(60% - 358px); }
  .platform-box_wrap .platform-body .body-content.body-content-11, .platform-box_wrap .platform-body .body-content.body-content-12, .platform-box_wrap .platform-body .body-content.body-content-14 { top: 60%; }
}

@media (max-width: 1600px) and (max-height: 820px) {
  .platform-box_wrap .platform-head-wrapper { height: 80px; padding: 15px 40px; width: 95%; }
  .platform-box_wrap .platform-head-wrapper .head-right .head-button { padding: 12px 26px; }
  .platform-box_wrap .platform-body .body-content { min-height: 394px; padding: 26px 70px 20px; top: 59%; }
  .platform-box_wrap .platform-body .body-content .body-title .intro-title, .platform-box_wrap .platform-body .body-content .body-title .name-title, .platform-box_wrap .platform-body .body-content .body-title p { font-size: 18px; }
  .platform-box_wrap .platform-body .body-content .sub-title { margin: 30px auto 11px; }
  .platform-box_wrap .platform-body .body-content .btn { height: 48px; }
}

@media (min-width: 1601px) and (max-height: 780px) {
  .platform-box_wrap .platform-head-wrapper { top: 0px; }
}

@media (min-width: 1601px) and (max-height: 640px) {
  .platform-box_wrap .platform-head-wrapper { display: none; }
}

@media (max-width: 1600px) and (max-height: 600px) {
  .platform-box_wrap .platform-head-wrapper { top: 0px; }
}

@media (max-width: 1600px) and (max-height: 470px) {
  .platform-box_wrap .platform-head-wrapper { display: none; }
}

@media (max-width: 1240px) {
  .platform-box_wrap .platform-head-wrapper { width: 100%; }
}

@media (max-width: 1200px) {
  .platform-box_wrap .platform-head-wrapper { width: 95%; }
  .platform-box_wrap .platform-head-wrapper .head-right .head-honor { display: none !important; }
