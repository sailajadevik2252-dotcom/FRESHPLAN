.shape-audio-player { display: flex; align-items: center; height: 100%; max-height: 80px; padding: 0px 5px; }

.shape-audio-player .left, .shape-audio-player .right { height: 100%; width: 45px; display: flex; align-items: center; justify-content: center; }

.shape-audio-player .left .play { cursor: pointer; }

.shape-audio-player .center { width: 100%; margin: 0px 10px; }

.shape-audio-player .center .title { display: flex; justify-content: space-between; align-items: baseline; user-select: none; font-size: 14px; }

.shape-audio-player .center .title .name { width: 120px; white-space: nowrap; line-height: 1.5; }

.shape-audio-player .center .title .tip { font-size: 12px; }

.shape-audio-player .center .title .tip .retry-btn { display: flex; cursor: pointer; }

.shape-audio-player .center .title .tip .retry-btn span { margin-left: 5px; }

.shape-audio-player .center .title .tip .time { font-weight: 350; }

.shape-audio-player .center .bar { height: 20px; display: flex; align-items: end; }

.shape-audio-player .right { position: relative; cursor: pointer; }

.m .shape-audio-player .center .title { display: none; }

.m .shape-audio-player .center .bar { align-items: center; }

.s .shape-audio-player { justify-content: center; }

.s .shape-audio-player .center, .s .shape-audio-player .right { display: none; }

.kd-tooltip.wo-tooltip .kd-tooltip-content { word-break: normal; overflow-wrap: break-word; }

.wo-button { display: inline-block; }

.wo-button.disabled { pointer-events: inherit; }

.wo-button.is-block, .wo-button .kd-button { width: 100%; }

.wo-button.with-theme { --kd-color-public-normal: var(--kd-color-brand-normal); --kd-color-public-hover: var(--kd-color-brand-hover); --kd-color-public-pressed: var(--kd-color-brand-pressed); --kd-color-public-light: var(--kd-color-brand-light); --kd-color-text-public: var(--kd-color-text-brand); --kd-color-state-pressed-public: var(--kd-color-state-pressed-brand); --kd-color-line-public: var(--kd-color-line-brand); --kd-color-icon-public: var(--kd-color-icon-brand); }

.wo-button .kd-icon { line-height: 0; }

.wo-button-xs .kd-button { height: 20px !important; }

.wo-button-xs .kd-button-icon { min-width: 20px !important; }

.shape-video-player { width: 100%; height: 100%; position: relative; }

.shape-video-player .video-source { height: 100%; width: 100%; display: flex; background: rgb(var(--kd-color-black)); }

.shape-video-player .video-source video { width: 100%; object-fit: cover; background-size: cover; background-position: 50% center; }

.shape-video-player .video-source video.fullscreen { object-fit: contain; background-image: unset !important; }

.shape-video-player .video-control { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; background-size: cover; background-position: 50% center; }

.shape-video-player .video-control > div { transition: 0.3s; position: relative; }

.shape-video-player .video-control.focus .bottom, .shape-video-player .video-control.focus .top { opacity: 1; transform: translateY(0px); pointer-events: unset; }

.shape-video-player .video-control .center { position: absolute; inset: 0px; background: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; transition: all; cursor: pointer; }

.shape-video-player .video-control .center.active { background: transparent; display: unset; position: unset; height: calc(100% - 100px); }

.shape-video-player .video-control .center.active .center-btn { display: none; }

.shape-video-player .video-control .center .center-btn { cursor: pointer; height: 45px; width: 45px; background: rgba(255, 255, 255, 0.3); display: flex; justify-content: center; align-items: center; border-radius: 8px; }

.shape-video-player .video-control .top { height: 50px; width: 100%; background: linear-gradient(rgba(0, 0, 0, 0.6), transparent); display: flex; justify-content: space-between; align-items: center; padding: 0px 15px; box-sizing: border-box; transform: translateY(-100%); pointer-events: none; z-index: 3; }

