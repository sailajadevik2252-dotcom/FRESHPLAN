.s .shape-video-player .video-load-status p { display: none; }

.s .shape-video-player .video-control .bottom, .s .shape-video-player .video-control .top { visibility: hidden; pointer-events: none; display: none; }

.s .shape-video-player .video-control .center { height: 100% !important; }

.s .shape-video-player .video-control .center .center-btn { transform: scale(0.6); }
