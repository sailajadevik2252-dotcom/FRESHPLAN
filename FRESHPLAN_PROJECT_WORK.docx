.wps-context-menu.component-context-menu .high-light-color .icons-20 { width: 24px; height: 24px; padding: 4px; }

.wps-context-menu.component-context-menu .color-icon { width: 26px; height: 26px; border-radius: 50%; background-color: rgb(0, 0, 0); }

.wps-context-menu.component-context-menu .button-icon-component { pointer-events: none; }

.context-menu-hide { visibility: hidden; }

.context-menu-item { display: inline-flex; height: 44px; min-width: 52px; }

.context-menu-item, .context-menu-item .menu-content { flex-direction: row; justify-content: center; align-items: center; }

.context-menu-item .menu-content { display: flex; padding: 8px 10px; gap: 4px; border-radius: 6px; background: var(--kd-color-state-normal,hsla(0,0%,5%,0)); margin: 1px 2px; }

.context-menu-item .menu-content:active { background: var(--kd-color-state-pressed,hsla(0,0%,5%,.1)); }

.context-menu-item .menu-content .menu-text { display: flex; justify-content: center; align-items: center; color: var(--kd-color-text-primary,hsla(0,0%,5%,.9)); text-align: center; font-family: "PingFang SC", "Microsoft YaHei"; font-size: 16px; font-style: normal; font-weight: 400; padding: 0px; }

.context-menu-item .context-menu-item-divide { display: flex; width: 1px; transform: scaleX(0.5); height: 28px; padding-left: 0.5px; box-sizing: border-box; flex-direction: column; align-items: center; justify-content: center; background: var(--kd-color-line-regular,hsla(0,0%,5%,.12)); }

.menu-line { width: calc(-32px + 100vw); position: relative; flex-direction: row; white-space: nowrap; align-items: center; height: 44px; justify-content: space-between; flex-shrink: 0; }

.menu-line .menu-line-item { display: flex; flex-direction: row; max-width: 520px; overflow-x: auto; white-space: nowrap; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; transition: 0.15s ease-in-out; scrollbar-width: none; }

.menu-line .menu-line-item::-webkit-scrollbar { display: none; }

.menu-line .menu-line-item.left { margin-left: 32px; }

.menu-line .menu-line-item.right { margin-right: 32px; }

.menu-line .menu-line-item .context-menu { display: flex; flex-direction: row; }

.menu-line .menu-line-item .context-menu .context-menu-item:last-child .context-menu-item-divide { display: none; }

.menu-line .menu-line-item-scroll { scroll-behavior: smooth; }

.menu-line .menu-scroll-button-left, .menu-line .menu-scroll-button-right { position: absolute; flex-direction: row; width: 42px; height: 44px; display: flex; align-items: center; align-self: stretch; z-index: 1; }

.menu-line .menu-scroll-button-left .scroll-button-icon, .menu-line .menu-scroll-button-right .scroll-button-icon { width: 32px; display: flex; padding: 12px 6px; flex-direction: column; justify-content: center; align-items: center; align-self: stretch; background: var(--kd-color-background-top,#fff); pointer-events: none; }

.menu-line .menu-scroll-button-left .scroll-button-icon svg, .menu-line .menu-scroll-button-right .scroll-button-icon svg { pointer-events: none; }

.menu-line .menu-scroll-button-left .scroll-button-mask, .menu-line .menu-scroll-button-right .scroll-button-mask { width: 10px; align-self: stretch; }

.menu-line .menu-scroll-button-left { top: 0px; left: -8px; opacity: 0; }

.menu-line .menu-scroll-button-left .scroll-button-mask { background: linear-gradient(90deg, rgb(255, 255, 255), rgba(255, 255, 255, 0)); }

.menu-line .menu-scroll-button-left.show { opacity: 1; left: 0px; }

.menu-line .menu-scroll-button-left.hide { opacity: 0; left: -8px; pointer-events: none; }

.menu-line .menu-scroll-button-right { top: 0px; opacity: 1; right: 0px; }

.menu-line .menu-scroll-button-right .scroll-button-mask { background: linear-gradient(270deg, rgb(255, 255, 255), rgba(255, 255, 255, 0)); }

.menu-line .menu-scroll-button-right.show { opacity: 1; right: 0px; }

.menu-line .menu-scroll-button-right.hide { opacity: 0; right: -8px; pointer-events: none; }

.menu-line .scroll-button-transition { transition: 0.15s ease-in-out; }

.menu-line .blank { display: flex; flex-direction: row; width: 50px; flex-shrink: 0; }

.animation-fade-in-left { animation: 0.2s ease 0s 1 normal none running fadeInLeft; }

@keyframes fadeInLeft { 
  0% { opacity: 0; transform: translate3d(100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

.red-split .kd-color-icon-green-primary { fill: var(--kd-color-icon-red-primary); stroke: var(--kd-color-icon-red-primary); }

.primary-fill .kd-color-icon-secondary { fill: var(--kd-color-icon-primary); stroke: var(--kd-color-icon-primary); }

.secondary-fill .kd-color-icon-primary { fill: var(--kd-color-icon-secondary); stroke: var(--kd-color-icon-secondary); }

.white-fill .kd-color-icon-primary { fill: var(--kd-color-icon-white); stroke: var(--kd-color-icon-white); }

.warn-lock .kd-color-icon-primary { fill: var(--kd-color-icon-warning); stroke: var(--kd-color-icon-warning); }

.blue-symbol-cross .kd-color-icon-primary { fill: var(--kd-color-icon-info); stroke: var(--kd-color-icon-info); }

.blue-success-normal .kd-color-icon-success { fill: rgb(var(--kd-color-blue-5)); stroke: rgb(var(--kd-color-blue-5)); }

@font-face { font-family: "Wps Emoji"; src: url("../../../fonts/iconfont.b0069a1e.ttf") format("truetype"); }

html, html body { overflow: hidden; }

html body { font-family: BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, "PingFang SC", "Microsoft Yahei", "Hiragino Sans GB", sans-serif, "Wps Emoji", "apple color emoji", "Noto Color Emoji", "segoe ui emoji", "segoe ui symbol"; text-size-adjust: 100% !important; }

.mobile.wps-preview { cursor: auto; user-select: auto; }

.mobile.wps-preview.no-copy { user-select: none; }

.mobile.wps-preview.no-copy .preview-page-container { position: relative; }

.mobile.wps-preview.no-copy .preview-page-container .no-copy-box { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; }

.mobile .content-container { display: flex; flex-direction: column; }

.mobile .edit-area { flex-grow: 1; overflow: hidden; background-color: rgb(255, 255, 255); margin-bottom: env(safe-area-inset-bottom); }

.mobile .edit-area #template-background-wrapper { position: fixed; inset: 0px; }

.mobile .edit-area #workspace.writer-container { position: relative; display: inline-block; overflow: hidden; z-index: 1; min-width: 100vw; top: 44px; }

.mobile .edit-area #workspace.writer-container.is-history { top: 0px; }

.mobile .edit-area #workspace.writer-container.card-mode { top: 0px !important; }

.mobile .edit-area #workspace.writer-container.pagination-mode { background-color: rgb(242, 244, 247); overflow-x: scroll; }

.mobile .edit-area #workspace.writer-container .doc-pending-canvas-unit { display: none; }

.mobile .edit-area .m-coop-container { z-index: 200; }

.mobile .edit-area #div_writer_grid { position: absolute; inset: 40px 0px 0px; overflow: hidden; width: 100%; height: calc(100% - 40px); }

.mobile .edit-area .wps-font-download-notification { z-index: 1000; }

.mobile .edit-area #workspace .wps-page-container .canvas-unit .page-num { position: absolute; bottom: 5px; left: 5px; z-index: 10000; background: rgb(77, 77, 77); color: rgb(231, 231, 231); font-size: 12px; height: 16px; line-height: 16px; border-radius: 2px; display: flex; align-items: center; justify-content: space-around; min-width: 24px; }

.mobile .edit-area #workspace .wps-page-container .canvas-unit .page-number-hidden { display: none !important; }

.mobile [data-dpr="2"] .dpr-border-top, [data-dpr="3"] .mobile .dpr-border-top { border-top-width: 0.5px !important; }

.mobile [data-dpr="2"] .dpr-border-left, [data-dpr="3"] .mobile .dpr-border-left { border-left-width: 0.5px !important; }

.mobile [data-dpr="2"] .dpr-border-right, [data-dpr="3"] .mobile .dpr-border-right { border-right-width: 0.5px !important; }

.mobile [data-dpr="2"] .dpr-border-bottom, [data-dpr="3"] .mobile .dpr-border-bottom { border-bottom-width: 0.5px !important; }

.mobile [data-dpr="2"] .dpr-border, [data-dpr="3"] .mobile .dpr-border { border-width: 0.5px !important; }

.mobile .avatar-item.editting .avatar-item-icon { opacity: 1; }

.mobile .avatar-item .avatar-item-icon { position: absolute; width: 8px; height: 8px; right: -2px; bottom: -2px; border-radius: 4px; opacity: 0; }

.xc-preview-container { position: fixed; height: 100%; width: 100%; display: flex; flex-direction: column; overflow: auto; }

.xc-preview-container .preview-page-container { transform-origin: left top; overflow: scroll; flex-grow: 1; height: 100%; }

.xc-preview-container .preview-page-container .pages-list { transform-origin: left top; transform: scale(1); text-align: center; padding-bottom: 20px; min-height: 101%; }

.xc-preview-container .preview-page-container .pages-list .page { position: relative; overflow: hidden; display: inline-block; background-color: rgb(255, 255, 255); box-shadow: rgba(157, 160, 164, 0.4) 0px 2px 12px 0px; margin: 20px 10px 0px; }

.xc-preview-container .preview-page-container .pages-list .page.unvisible svg { display: none; }

.xc-preview-container .preview-page-container .pages-list .page .page-num { position: absolute; bottom: 5px; left: 5px; z-index: 10000; background: rgb(77, 77, 77); color: rgb(231, 231, 231); font-size: 12px; height: 16px; line-height: 16px; border-radius: 2px; display: flex; align-items: center; justify-content: space-around; min-width: 24px; }

.component-notice .component-notice-content .notice-content .function-limit-notice-content-guide { text-decoration: underline; }

.vertical-center { display: flex; align-items: center; }

.horizontal-center { display: flex; justify-content: center; }

.notice-body { font-size: 12px; }

.page-outside-container { width: 100%; position: absolute; top: 3000px; }

.more-menus-component-panel.component-half-screen-panel .panel-body .panel-content { touch-action: pan-x pan-y; }

#workspace image { image-rendering: var(--wps-image-rendering,crisp-edges); }

