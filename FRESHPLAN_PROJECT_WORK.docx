.component-recorder-tip .recorder-tip-top .tips-wrap { display: flex; justify-content: space-around; overflow: hidden; position: relative; width: 40px; }

.component-recorder-tip .recorder-tip-top .tips-wrap::before { content: ""; width: 40px; height: 14px; background: rgba(37, 37, 37, 0.9); position: absolute; opacity: 0.7; top: -1px; animation: 2s linear 0s infinite normal none running recorder-tips-playing; }

.component-recorder-tip .recorder-tip-top .tips-left::before { left: 0px; }

.component-recorder-tip .recorder-tip-top .tips-right::before { right: 0px; }

