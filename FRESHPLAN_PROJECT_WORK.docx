.embed-container-full-screen .component-half-screen-panel.show-mask .panel-body { position: absolute; }

.fake-grid-wrap { font-family: ET-HEADERS-FONT; color: rgb(61, 71, 87); position: absolute; left: 0px; display: flex; text-align: center; overflow: hidden; transform-origin: left top; z-index: 1050; background: transparent; }

.fake-grid-wrap .row-wrap { flex-shrink: 0; }

.fake-grid-wrap .row-wrap .row { position: relative; }

.fake-grid-wrap .row-wrap .row::before { content: ""; position: absolute; width: 100%; height: 1px; top: 0px; left: 0px; background-image: linear-gradient(90deg, rgb(242, 244, 247), rgb(215, 218, 222)); }

.fake-grid-wrap .col-wrap { flex-grow: 1; flex-shrink: 1; position: relative; display: flex; flex-direction: column; }

.fake-grid-wrap .col-wrap .num-wrap { flex-shrink: 0; display: flex; }

.fake-grid-wrap .col-wrap .col { position: relative; }

.fake-grid-wrap .col-wrap .col::before { content: ""; position: absolute; width: 1px; height: 100%; top: 0px; left: 0px; right: 0px; background-image: linear-gradient(rgb(242, 244, 247), rgb(215, 218, 222)); }

.fake-grid-wrap .col-wrap .grid { flex-grow: 1; flex-shrink: 1; background: linear-gradient(90deg, rgb(215, 218, 222) 1px, transparent 0px), linear-gradient(rgb(215, 218, 222) 1px, transparent 0px); }

.wpp-fake-wrap { background: var(--kd-color-background-base); color: var(--kd-color-text-primary); position: fixed; left: 0px; bottom: 0px; overflow: auto; z-index: 1050; }

.wpp-fake-wrap .wpp-svg-container-pc { height: 100%; position: absolute; top: 0px; width: calc(100% - 200px); left: 200px; display: flex; align-items: center; justify-content: center; }

.wpp-fake-wrap.hide-thumbnail .wpp-svg-container-pc { width: 100%; left: 0px; }

.wpp-fake-wrap .svg-preview-pc { box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 16px; background: rgb(255, 255, 255); }

.wpp-fake-wrap .svg-preview-pc svg { overflow: visible; }

.wpp-fake-wrap .svg-preview-mobile { background: rgb(255, 255, 255); margin-bottom: 12px; overflow: hidden; position: relative; box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 8px 0px !important; }

.wpp-fake-wrap .svg-preview-mobile svg { overflow: visible; }

.wpp-fake-wrap .svg-preview-mobile .page-index { position: absolute; left: 5px; bottom: 5px; padding: 0px 6px; line-height: 16px; font-size: 12px; border-radius: 2px; min-width: 24px; text-align: center; background-color: rgba(0, 0, 0, 0.7); color: rgb(255, 255, 255); white-space: nowrap; }

.wpp-fake-wrap .wpp-svg-container-mobile { height: 100%; position: absolute; top: 0px; width: 100%; left: 0px; display: flex; align-items: center; justify-content: center; }

.wpp-fake-wrap .svg-fake-loading { background: url("images/slide-loading.c347b701.svg") 0% 0% / 100% auto; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 80%; padding-top: 35.04%; }

.kslide-fake-wrap { background: rgb(242, 244, 247); color: rgb(61, 71, 87); position: fixed; left: 0px; bottom: 0px; overflow: auto; z-index: 1050; width: 100%; }

.kslide-fake-wrap .kslide-svg-container-pc { height: 100%; position: absolute; top: 0px; width: calc(100% - 458px); left: 200px; display: flex; align-items: center; justify-content: center; }

.kslide-fake-wrap .svg-preview-pc { box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 16px; background: rgb(255, 255, 255); }

.kslide-fake-wrap .svg-preview-pc svg { overflow: visible; }

.kslide-fake-wrap .svg-preview-mobile { background: rgb(255, 255, 255); margin-bottom: 12px; overflow: hidden; position: relative; box-shadow: rgba(0, 0, 0, 0.2) 0px 2px 8px 0px !important; }

.kslide-fake-wrap .svg-preview-mobile svg { overflow: visible; }

.kslide-fake-wrap .svg-preview-mobile .page-index { position: absolute; left: 5px; bottom: 5px; padding: 0px 6px; line-height: 16px; font-size: 12px; border-radius: 2px; min-width: 24px; text-align: center; background-color: rgba(0, 0, 0, 0.7); color: rgb(255, 255, 255); white-space: nowrap; }

