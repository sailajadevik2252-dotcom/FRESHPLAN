@charset "utf-8";

#loadError { display: none; flex-direction: column; justify-content: center; align-items: center; position: fixed; top: 0px; z-index: 10000; width: 100%; height: 100%; background: rgb(255, 255, 255); font-size: 12px; }

#loadError .title { font-size: 16px; line-height: 26px; margin-bottom: 30px; }

#loadError .btn { padding: 8px 30px; background: rgb(65, 127, 249); color: rgb(255, 255, 255); border-radius: 4px; cursor: pointer; font-size: 14px; margin-bottom: 10%; }

#loadError .btn:active, #loadError .btn:focus { background: rgb(58, 114, 223); }

#loadError.loadFail { display: flex; }
