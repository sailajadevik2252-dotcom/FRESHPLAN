.comment-success-toast-divider { text-align: center; display: inline-block; height: 18px; width: 1px; background-color: rgb(255, 255, 255); margin: 0px 10px -4px; border: 0px; padding: 0px; font-weight: lighter; }

.comment_input_tip { position: absolute; left: 0px; pointer-events: none; height: 100%; font-size: 14px; color: var(--kd-color-text-secondary); line-height: 30px; margin: auto 0px auto 10px; width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.temp_comment_input_wrapper { position: relative; }

.temp_comment_input_wrapper:not(.is-mobile) { border: 1px solid var(--kd-color-line-public); border-radius: 5px; }

.temp_comment_input_wrapper.is-mobile { border-radius: 4px; border: 1px solid rgb(226, 230, 237); }

.temp_comment_input { min-height: 30px; font-size: 14px; line-height: 30px; padding: 0px 10px; }

.temp_comment_input, .temp_comment_input .isMention { user-select: text; }

.temp_comment_input .isMention { -webkit-user-modify: read-only; color: var(--kd-color-text-info); display: inline-block; line-height: 25px; }

.cmt-input-btn-group { margin-top: 8px; display: flex; flex-direction: row-reverse; }

.cmt-input-btn-group .cmt-btn { min-width: 72px; margin-right: 0px; margin-left: 8px; }

[dir="rtl"] .temp_comment_input_wrapper { direction: rtl; }

[dir="rtl"] .comment_input_tip { left: auto; right: 0px; margin: auto 10px auto 0px; text-align: right; }

[dir="rtl"] .temp_comment_input { text-align: right; }

.wps-voice-recorder { display: flex; justify-content: center; align-items: center; width: 100%; }

.comment-input-options-panel { padding: 8px 10px; display: flex; flex-direction: column; align-items: flex-start; border-top: 1px solid rgba(8, 14, 23, 0.12); background-color: rgb(255, 255, 255); }

