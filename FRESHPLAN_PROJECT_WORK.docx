@charset "utf-8";

.ai-guide-header[data-v-d8284756] { position: fixed; top: 0px; left: 0px; display: flex; align-items: center; justify-content: space-between; width: 100%; height: 48px; padding: 0px 16px; background-color: rgb(255, 255, 255); border-bottom: 0.5px solid rgba(0, 0, 0, 0.1); }

.ai-guide-header .doc-title[data-v-d8284756] { flex: 1 1 0%; max-height: 100%; font-size: 14px; font-weight: 700; color: rgba(13, 13, 13, 0.9); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.ai-guide-header .edit-icon[data-v-d8284756] { display: inline-block; margin: 0px 12px; width: 20px; height: 20px; background: url("data:image/svg+xml;base64,") no-repeat; }

.ai-guide-header .edit-button[data-v-d8284756] { height: 24px; padding: 0px 11px; font-size: 12px; border-radius: 12px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; color: rgb(255, 255, 255); background-color: rgb(65, 127, 249); }
------MultipartBoundary--I3yG6XVhTcTGkyKy038XMBGlS5t74F60Eg08sLKCfM----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-8f58fcc9-3a07-4ad2-a648-c48729e8b2b8@mhtml.blink

@charset "utf-8";

body, html { margin: 0px; padding: 0px; }

#__layout, #__layout > div, #__nuxt, body, html { width: 100%; height: 100%; }

.background-image { background-size: contain; background-repeat: no-repeat; background-position: 50% center; }

.no-scrollbar { scrollbar-width: none; }

.no-scrollbar::-webkit-scrollbar { display: none; }

* { font-family: Roboto, Manrope, "Noto Sans", "Segoe UI", Avenir, Helvetica, Arial, sans-serif !important; box-sizing: border-box; }

body { overflow: hidden; }

.ai-guide-container { position: relative; height: 100%; overflow: hidden; }

.ai-guide-container .doc-iframe { border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px; margin: 0px; width: 100%; height: 100%; }

.ai-guide-container .background-mask { position: fixed; inset: 0px; background-color: rgba(0, 0, 0, 0.4); z-index: 0; }

.ai-guide-container .wps-ai-button-wrapper { z-index: 1; }

.ai-guide-container .edit-with-wps-footer { position: relative; z-index: 2; }

.ai-guide-container .emphasis { color: rgba(0, 0, 0, 0.9); }
------MultipartBoundary--I3yG6XVhTcTGkyKy038XMBGlS5t74F60Eg08sLKCfM----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-e11fd47f-6fc7-404a-b711-e2c8fe5bf088@mhtml.blink

@charset "utf-8";

.popup-container[data-v-c6ea0d12] { z-index: 3; padding: 20px 24px 30px; }

.popup-container .popup-title[data-v-c6ea0d12] { font-size: 16px; font-weight: 700; line-height: 24px; text-align: center; color: rgba(0, 0, 0, 0.9); }

.popup-container .popup-content[data-v-c6ea0d12] { margin-top: 16px; font-size: 14px; font-weight: 400; line-height: 22px; color: rgba(0, 0, 0, 0.6); }

.popup-container .line[data-v-c6ea0d12] { margin: 16px 0px; height: 1px; background-color: rgba(0, 0, 0, 0.1); }

.popup-container .input-label[data-v-c6ea0d12] { font-size: 12px; font-weight: 400; line-height: 20px; color: rgba(0, 0, 0, 0.6); }

.popup-container .email-input[data-v-c6ea0d12] { margin-top: 4px; width: 100%; height: 40px; padding: 9px 12px; border-radius: 8px; border: 0.5px solid rgb(208, 211, 216); font-size: 14px; font-weight: 400; line-height: 22px; color: rgba(0, 0, 0, 0.9); caret-color: rgb(65, 127, 249); }

.popup-container .email-input.focus-visible[data-v-c6ea0d12], .popup-container .email-input[data-v-c6ea0d12]:focus, .popup-container .email-input[data-v-c6ea0d12]:focus-visible, .popup-container .email-input[data-v-c6ea0d12]:hover { outline: none; border: 1px solid rgb(65, 127, 249); }

.popup-container .email-input[data-v-c6ea0d12]::placeholder { color: rgba(0, 0, 0, 0.4); }

.popup-container .email-input.error[data-v-c6ea0d12] { border: 1px solid rgb(228, 76, 76) !important; }

.popup-container .error-hint[data-v-c6ea0d12] { height: 0px; font-size: 12px; font-weight: 400; line-height: 20px; color: rgb(228, 76, 76); }

.popup-container .submit-btn[data-v-c6ea0d12] { margin-top: 32px; width: 100%; height: 48px; border-radius: 24px; font-size: 16px; font-weight: 700; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background-color: rgb(65, 127, 249); color: rgb(255, 255, 255); }
------MultipartBoundary--I3yG6XVhTcTGkyKy038XMBGlS5t74F60Eg08sLKCfM----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-c54bf6b9-13ca-41cf-a1de-02fb304d72c0@mhtml.blink

@charset "utf-8";

.popup-container[data-v-079b0c27] { z-index: 3; padding: 20px 24px 30px; }

.popup-container .popup-title[data-v-079b0c27] { font-size: 16px; font-weight: 700; line-height: 24px; text-align: center; color: rgba(0, 0, 0, 0.9); }

.popup-container .mail-image[data-v-079b0c27] { display: block; width: 30vw; max-width: 100px; margin: 20px auto 0px; }

.popup-container .popup-content[data-v-079b0c27] { margin-top: 16px; font-size: 14px; font-weight: 400; line-height: 22px; color: rgba(0, 0, 0, 0.6); }

.popup-container .got-it-btn[data-v-079b0c27] { margin-top: 32px; width: 100%; height: 48px; border-radius: 24px; font-size: 16px; font-weight: 700; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; background-color: rgb(65, 127, 249); color: rgb(255, 255, 255); }
