.platform-box_wrap .platform-body .body-content .sub-title.ellis { overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

.platform-box_wrap .platform-body .body-content .btn { text-align: center; height: 44px; line-height: 44px; width: 300px; border-radius: 6px; font-size: 16px; margin: 0px auto; cursor: pointer; }

.platform-box_wrap .platform-body .body-content .btn.open-wps { background-color: rgb(66, 133, 244); color: rgb(255, 255, 255); position: relative; font-weight: 700; }

.platform-box_wrap .platform-body .body-content .btn.open-wps .arrow { position: absolute; margin-left: 5px; top: 17px; width: 10px; height: 10px; }

.platform-box_wrap .platform-body .body-content .btn.open-wps .arrow.dm-arr { animation: 0.5s ease 0s 5 normal none running mymove; }

.platform-box_wrap .platform-body .body-content .btn.open-wps .arrow.fat-arrow { width: 20px; height: 20px; top: 11px; }

.platform-box_wrap .platform-body .body-content .btn.open-wps .arrow.transform { transform: rotateY(180deg); margin-left: 0px; margin-right: 5px; }

.platform-box_wrap .platform-body .body-content .btn.open-wps:hover { background: rgb(96, 141, 250); }

.platform-box_wrap .platform-body .body-content .btn.open-wps:active { background: rgb(31, 114, 241); }

.platform-box_wrap .platform-body .body-content .btn.open-wps .hot { position: absolute; top: -1px; right: -1px; height: 31px; width: 31px; }

@keyframes mymove { 
  50% { margin-left: 9px; }
}

.platform-box_wrap .platform-body .body-content .btn.open-wps.use-dynamic-3 { background: url("https://global-static.wpscdn.com/cms/docs/img/sweeplight.922ff28.gif") center top no-repeat; }

.platform-box_wrap .platform-body .body-content .btn.open-wps.use-dynamic-4 { background: url("https://global-static.wpscdn.com/cms/docs/img/breathe.804a27e.gif") center top no-repeat; }

.platform-box_wrap .platform-body .body-content .btn.open-wps.use-dynamic-7 { animation: 0.5s ease 0s 5 normal none running myzoom; }

@keyframes myzoom { 
  50% { width: 293px; height: 48px; line-height: 48px; font-size: 15px; margin-bottom: 8px; }
}

.platform-box_wrap .platform-body .body-content .btn.open-wps.use-dynamic-8 { border-radius: 50px; }

.platform-box_wrap .platform-body .body-content .btn.open-browser { background-color: rgb(255, 255, 255); border: 1px solid rgb(216, 216, 216); font-size: 14px; line-height: 14px; margin-top: 16px; height: 22px; }

.platform-box_wrap .platform-body .body-content .btn.open-browser.use-dynamic-5, .platform-box_wrap .platform-body .body-content .btn.open-browser.use-dynamic-6, .platform-box_wrap .platform-body .body-content .btn.open-browser.use-dynamic-7, .platform-box_wrap .platform-body .body-content .btn.open-browser.use-dynamic-8, .platform-box_wrap .platform-body .body-content .btn.open-browser.use-dynamic-9, .platform-box_wrap .platform-body .body-content .btn.open-browser.use-dynamic-10 { border: 0px; text-decoration: underline; color: rgb(66, 133, 244); }

.platform-box_wrap .platform-body .body-content .btn.open-browser.use-dynamic-5 { color: rgb(66, 133, 244); }

.platform-box_wrap .platform-body .body-content .btn.open-browser.use-dynamic-10 { color: rgb(118, 124, 133); }

@media (max-height: 900px) {
  .platform-box_wrap .platform-body .body-top.body-brand.body-brand-13 { top: 30px; }
  .platform-box_wrap .platform-body .body-bottom.body-brand { bottom: 20px; }
