.wps-context-menu.component-context-menu .context-menu-container .menu-line-divider { content: ""; position: absolute; display: flex; left: 8px; right: 8px; height: 1px; transform: scaleY(0.5); box-sizing: border-box; padding-top: 0.5px; gap: 8px; background: var(--kd-color-line-regular,hsla(0,0%,5%,.12)); z-index: 2; }

