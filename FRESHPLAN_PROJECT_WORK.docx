.wo-switch { cursor: pointer; flex-shrink: 0; display: inline-flex; align-items: center; }

.wo-switch .switch-content { margin-left: 8px; }

.kd-switch { position: relative; display: inline-block; height: 24px; font-size: var(--kd-font-size-sub-base); line-height: 24px; vertical-align: middle; }

.kd-switch.is-disabled { opacity: var(--kd-opacity-disabled); }

.kd-switch.is-disabled .kd-switch-core, .kd-switch.is-loading .kd-switch-core { cursor: not-allowed; }

.kd-switch.is-loading .kd-icon-loading { height: 100%; will-change: auto; vertical-align: top !important; }

.kd-switch.is-loading .kd-icon-loading svg { vertical-align: inherit; }

.kd-switch-input { display: none; }

.kd-switch-core { position: relative; z-index: 1; display: inline-block; width: 42px; height: 24px; margin: 0px; cursor: pointer; background: var(--kd-color-fill-extra-heavy); border-radius: var(--kd-border-radius-extra-large); outline: none; box-sizing: border-box; transition: border-color 0.3s, background-color 0.3s; }

.kd-switch-core .kd-switch-button { position: absolute; top: 50%; left: 3px; width: 18px; height: 18px; background-color: rgba(var(--kd-color-white),1); border-radius: var(--kd-border-radius-circle); transition: left 0.3s; transform: translateY(-50%); }

[dir="rtl"] .kd-switch-core .kd-switch-button { left: auto; right: 3px; transition: right 0.3s; }

.kd-switch.is-checked .kd-switch-core { background-color: var(--kd-color-public-normal); }

.kd-switch.is-checked .kd-switch-button { left: calc(100% - 21px); }

[dir="rtl"] .kd-switch.is-checked .kd-switch-button { left: auto; right: calc(100% - 21px); }

.kd-switch.is-checked .kd-icon-loading { color: var(--kd-color-public-normal); }

.kd-switch--small { height: 16px; line-height: 16px; }

.kd-switch--small .kd-switch-core { height: 16px; }

.kd-switch--small .kd-switch-button { left: 2px; width: 12px; height: 12px; }

[dir="rtl"] .kd-switch--small .kd-switch-button { left: auto; right: 2px; }

.kd-switch--small.is-checked .kd-switch-button { left: calc(100% - 14px); }

[dir="rtl"] .kd-switch--small.is-checked .kd-switch-button { left: auto; right: calc(100% - 14px); }

.kd-icon-loading, .kd-icon-loading_white { animation: 0.8s linear 0s infinite normal none running spinning-ltr; }

[dir="rtl"] .kd-icon-loading, [dir="rtl"] .kd-icon-loading_white { animation: 0.8s linear 0s infinite normal none running spinning-rtl; }

.kd-icon-loading_white svg, .kd-icon-loading svg { animation: auto ease 0s 1 normal none running none !important; }

.kd-icon-loading.kd-icon-loading-comp .kd-stroke-width-icon-regular, .kd-icon-loading_white.kd-icon-loading-comp .kd-stroke-width-icon-regular { stroke-width: 2px; }

@keyframes spinning-ltr { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

@keyframes spinning-rtl { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(-1turn); }
}

.kd-icon { display: inline-block; color: inherit; font-style: normal; line-height: 0; text-align: center; text-transform: none; text-rendering: optimizelegibility; -webkit-font-smoothing: antialiased; }

.kd-icon-spin svg { animation: 1s linear 0s infinite normal none running kd-icon-spin; }

.kd-icon-rtl-mirror.kd-icon-dir-rtl svg { transform: scaleX(-1); }

.kd-icon-rtl-variant { --kd-visibility-dir-ltr: visible; --kd-visibility-dir-rtl: hidden; }

.kd-icon-rtl-variant.kd-icon-dir-rtl { --kd-visibility-dir-ltr: hidden; --kd-visibility-dir-rtl: visible; }

.kd-icon-rtl-variant.kd-icon-dir-ltr { --kd-visibility-dir-ltr: visible; --kd-visibility-dir-rtl: hidden; }

[dir="rtl"] .kd-icon-rtl-mirror:not(.kd-icon-dir-ltr):not(.kd-icon-dir-rtl) svg { transform: scaleX(-1); }

[dir="rtl"] .kd-icon-rtl-variant:not(.kd-icon-dir-ltr):not(.kd-icon-dir-rtl) { --kd-visibility-dir-ltr: hidden; --kd-visibility-dir-rtl: visible; }

@keyframes kd-icon-spin { 
  100% { transform: rotate(1turn); }
}

.component-bottom-dialog { position: absolute; inset: 0px; z-index: 1010; }

