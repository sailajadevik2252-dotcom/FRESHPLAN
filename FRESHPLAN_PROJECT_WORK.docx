.shape-video-player .video-load-status { height: 100%; width: 100%; display: flex; align-items: center; flex-direction: column; justify-content: center; padding: 0px 40px; text-align: center; background-color: rgb(255, 255, 255); position: absolute; z-index: 4; }

.shape-video-player .video-load-status p { margin: 15px; font-size: 12px; white-space: nowrap; max-width: 60%; }

